      const lookDown=(this.keys.PageDown||this.keys.Numpad2)?1:0,lookUp=(this.keys.PageUp||this.keys.Numpad8)?1:0,lookTarget=(lookDown-lookUp)*H*.30;this.cameraLookY+=(lookTarget-this.cameraLookY)*Math.min(1,dt*8);
