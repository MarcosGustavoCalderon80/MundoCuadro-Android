        const marine=[['fish',1810,GROUND+25],['seahorse',1950,GROUND+65],['jellyfish',2080,GROUND+5],['eel',2220,GROUND+105],['fish',2380,GROUND+55],['crab',2500,GROUND+145],['shark',2580,GROUND+40]];
        for(const [type,mx,my] of marine){const sp=enemySpec(type);d.enemies.push({id:uid('sea'),x:mx,y:my,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type,phase:r()*6,baseX:mx,baseY:my,dir:r()>.5?1:-1,shotCd:1,state:'swim'});}
        d.decor.push({type:'decor_coral',x:1840,y:GROUND+172,color:'#ff718d'},{type:'decor_seaweed',x:1990,y:GROUND+170,color:'#55d991'},{type:'decor_anemone',x:2150,y:GROUND+178,color:'#b079ff'},{type:'decor_shell',x:2320,y:GROUND+184,color:'#ffd078'},{type:'decor_bubbles',x:2460,y:GROUND+105,color:'#77efff'});
      }
