      if(!p.swim&&jump&&down&&!this.jumpHeld&&p.onGround&&dropAllowed){this.setCrouch(false);this.dropThroughId=standing.id;this.dropThroughTimer=.42;p.y+=20;p.vy=220;p.onGround=false;p.standingOnId=null;dropPerformed=true;this.flash('▼ BAJAR DE PLATAFORMA',500)}
      if(!p.swim)this.setCrouch(!!down&&p.onGround&&!dropPerformed);
      let ax=0;if(left)ax--;if(right)ax++;const accel=p.swim?1150:2300,max=this.hero.speed*(p.swim?.72:1)*(p.crouching?.42:1);if(ax){p.vx+=ax*accel*dt;p.dir=ax>0?1:-1}else p.vx*=Math.pow(p.swim?.02:.0008,dt);p.vx=clamp(p.vx,-max,max);
      if(p.swim){this.setCrouch(false);p.vy*=Math.pow(.08,dt);p.vy+=300*dt;if(up||jump)p.vy-=930*dt;if(down)p.vy+=650*dt;p.vy=clamp(p.vy,-360,430)}else{if(jump&&!this.jumpHeld&&!p.crouching&&!dropPerformed){if(p.onGround){p.vy=-this.hero.jump;p.onGround=false;p.doubleJump=this.airJumpCapacity()}else if(p.doubleJump>0){p.vy=-this.hero.jump*.90;p.doubleJump--;this.burst(p.x+p.w/2,p.y+p.h,'#78f4ff',12);this.flash(p.doubleJump>=1?'TRIPLE IMPULSO':'DOBLE SALTO',550);}}p.vy=Math.min(1250,p.vy+2250*dt);if(this.summonType==='unicorn'&&jump&&!p.onGround&&!p.groundPound){p.vy-=1550*dt;p.vy=clamp(p.vy,-520,650)}}this.jumpHeld=!!jump;
      if(!dropPerformed&&!p.swim&&!p.onGround&&down&&!this.downHeld&&!p.groundPound&&this.dropThroughTimer<=0){p.groundPound=true;p.vx*=.24;p.vy=Math.max(1250,p.vy);this.burst(p.x+p.w/2,p.y+p.h,'#ffd45d',10);this.flash('GOLPE HACIA ABAJO',550)}this.downHeld=!!down;
      if(dash&&!this.dashHeld&&this.dashCd<=0){p.vx=p.dir*(MC.state.data.avatar.heroBase==='runner'?1050:820);p.dash=.16;this.burst(p.x+p.w/2,p.y+p.h*.65,'#65eaff',8);this.dashCd=MC.state.data.avatar.heroBase==='runner'?.38:.78}this.dashHeld=!!dash;if(p.dash>0)p.dash-=dt;
      if(attack&&!this.attackHeld&&this.attackCd<=0){this.firePlayer(up?-1:down?1:0);this.attackCd=this.hero.cadence}this.attackHeld=!!attack;
