        add(`dest_${level}_3`,startX+520,GROUND-570,240,34,'semisolid',pal[4]);
        portalPlatform=add(`dest_${level}_goal`,startX+850,GROUND-430,460,100,'platform',pal[0]);
        d.goal={x:portalPlatform.x+310,y:portalPlatform.y-160,w:90,h:160};d.minY=Math.min(d.minY??-260,GROUND-760);coins(startX+15,GROUND-175,3);coins(startX+350,GROUND-355,4);coins(startX+875,GROUND-485,5);
      }else{
        // Canyon finish: descend first, then climb out on an elevator.
        add(`dest_${level}_0`,startX,GROUND+70,260,34,'semisolid',pal[1]);
        add(`dest_${level}_1`,startX+330,GROUND+260,300,100,'platform',pal[2]);
        add(`dest_${level}_2`,startX+700,GROUND+110,220,30,'elevator',pal[3],{axis:'y',range:180,speed:.9});
        portalPlatform=add(`dest_${level}_goal`,startX+1040,GROUND-120,360,100,'platform',pal[4]);
        d.goal={x:portalPlatform.x+210,y:portalPlatform.y-160,w:90,h:160};d.maxY=Math.max(d.maxY??GROUND+360,GROUND+610);d.minY=Math.min(d.minY??-260,GROUND-430);coins(startX+15,GROUND+20,4);coins(startX+350,GROUND+205,4);coins(startX+1060,GROUND-175,5);
      }
      d.checkpoints.push({x:startX+30,y:(d.platforms.find(q=>q.id===`dest_${level}_0`)?.y||GROUND)-100,w:48,h:100,active:false});
    }
    enemyPoolForWorld(world=this.world,feature=''){
      if(world===1)return['blob','hopper','charger','drone'];
      if(world===2)return['hopper','charger','guard','turret','bat','drone'];
      if(world===3)return['guard','turret','charger','bat','drone','hopper'];
      if(world===4)return['drone','bat','turret','charger','hopper'];
      if(world===5)return /ice|glacier/.test(feature)?['hopper','drone','charger','bat','guard']:['charger','guard','turret','drone','bat'];
      if(world===6)return['hopper','charger','drone','turret','blob','bat'];
      if(world===7)return /ocean|marine|swamp/.test(feature)?['fish','jellyfish','eel','shark','crab']:['bat','drone','charger','guard','turret'];
      return['guard','turret','charger','drone','bat','hopper'];
    }
    ensureEnemyPopulation(d,level=this.level){
      if(!d||d.isCustom)return;const feature=String(d.design?.feature||''),pool=this.enemyPoolForWorld(this.world,feature),bossLevel=d.objective?.type==='boss'||level%5===0,target=d.objective?.type==='defeat'?Math.max(1,+d.objective.target||3):0,minAmbient=bossLevel?0:Math.max(3,Math.min(7,3+Math.floor((level-1)/8))),desired=Math.max(target,minAmbient),spots=this.safeSpots(d).filter(p=>p.x>(d.spawn?.x||0)+500&&p.x<(d.goal?.x||d.width)-300&&p.w>=170);
      const nonBoss=d.enemies.filter(e=>e.type!=='boss');let seed=level*17+this.world*11;
      while(nonBoss.length<desired&&spots.length){const p=spots[(seed+nonBoss.length*3)%spots.length],type=pool[(seed+nonBoss.length)%pool.length],sp=enemySpec(type),air=['drone','bat'].includes(type),ex=p.x+Math.max(55,Math.min(p.w-sp.w-20,60+(nonBoss.length*73)%Math.max(80,p.w-sp.w-80))),ey=air?p.y-sp.h-80:p.y-sp.h,e={id:uid('enc'),x:ex,y:ey,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type,phase:(seed+nonBoss.length)*.37,baseX:ex,baseY:ey,dir:nonBoss.length%2?1:-1,shotCd:.8,state:air?'fly':'idle',objective:false};d.enemies.push(e);nonBoss.push(e)}
      if(target){const mission=d.enemies.filter(e=>e.type!=='boss');for(let i=0;i<mission.length;i++)mission[i].objective=i<target;}
      // Ground-bound enemies must sit on a reachable surface instead of appearing in empty space.
      const groundTypes=new Set(['blob','hopper','charger','guard','turret','crab']);const stable=this.safeSpots(d);
      for(const e of d.enemies){if(e.type==='boss'||!groundTypes.has(e.type))continue;const cx=e.x+e.w/2,feet=e.y+e.h;let support=stable.filter(p=>cx>=p.x&&cx<=p.x+p.w).sort((a,b)=>Math.abs(a.y-feet)-Math.abs(b.y-feet))[0];if(!support||Math.abs(support.y-feet)>150){support=stable.sort((a,b)=>Math.abs((a.x+a.w/2)-cx)-Math.abs((b.x+b.w/2)-cx))[0]}if(support){e.x=clamp(e.x,support.x+8,Math.max(support.x+8,support.x+support.w-e.w-8));e.y=support.y-e.h;e.baseX=e.x;e.baseY=e.y}}
    }
    snapNPCsToGround(d){
      if(!d?.npcs?.length)return;const stable=(d.platforms||[]).filter(p=>p.hp!==0&&p.w>=120&&!['moving','elevator','crumble'].includes(p.type)).sort((a,b)=>a.x-b.x);
      const personalities=['helpful','brave','curious','cheerful','serious','inventive'];
      for(let i=0;i<d.npcs.length;i++){const n=d.npcs[i];n.w=n.w||58;n.h=n.h||88;const cx=n.x+n.w/2,feet=n.y+n.h;let support=stable.filter(p=>cx>=p.x+6&&cx<=p.x+p.w-6).sort((a,b)=>Math.abs(a.y-feet)-Math.abs(b.y-feet))[0];if(!support||Math.abs(support.y-feet)>130){support=stable.filter(p=>p.x>(d.spawn?.x||0)+180).sort((a,b)=>Math.abs((a.x+a.w/2)-cx)-Math.abs((b.x+b.w/2)-cx))[0]}if(support){n.x=clamp(n.x,support.x+12,Math.max(support.x+12,support.x+support.w-n.w-12));n.y=support.y-n.h;n.baseX=n.x;n.baseY=n.y;n.supportId=support.id||null}n.personality=n.personality||personalities[(i+this.world)%personalities.length];n.variant=n.variant??((i+this.world+this.level)%4);n.patrolRange=Math.min(54,Math.max(18,n.patrolRange||28));n.biome=n.biome||this.npcBiome(n);if(String(n.id||'').startsWith('ambient_')){const sets={miner:[['mechanic','Bruna'],['scout','Talo'],['villager','Mina']],knight:[['guard','Sir Cubo'],['villager','Mira'],['scout','Escudero']],polar:[['guide','Nika'],['scout','Polo'],['villager','Kori']],volcanic:[['mechanic','Brasa'],['guard','Ferro'],['inventor','Magma']],coastal:[['sailor','Coral'],['guide','Nemo'],['merchant','Perla']],sky:[['scout','Nube'],['inventor','Volt'],['guide','Aero']],toy:[['inventor','Chispa'],['merchant','Mimi'],['villager','Pipo']],void:[['scout','Vanta'],['inventor','Orbi'],['guard','Nox']],meadow:[['guide','Lumi'],['scout','Pico'],['villager','Mora']]},pick=(sets[n.biome]||sets.meadow)[i%(sets[n.biome]||sets.meadow).length];n.kind=pick[0];n.name=pick[1]}}
    }

    addWizardChallengeNPC(d,level=this.level){if(!d||level%5!==0||d.npcs?.some(n=>n.special==='wizardQuiz'))return;const spots=this.safeSpots(d).filter(p=>p.x>(d.spawn?.x||0)+500&&p.x<(d.goal?.x||d.width)-500&&p.w>=220);const p=spots[Math.max(0,Math.min(spots.length-1,Math.floor(spots.length*.32)))]||this.safeSpots(d)[1];if(!p)return;d.npcs.push({id:`wizard_${level}`,special:'wizardQuiz',species:'wizard',kind:'inventor',name:'Mago Oráculo',x:p.x+p.w*.55-34,y:p.y-104,w:68,h:104,baseX:p.x+p.w*.55-34,baseY:p.y-104,phase:1.1,dir:1,personality:'mysterious',patrolRange:8,questGiver:false,text:'Tengo tres preguntas opcionales. Un acierto invoca a Joshi; tres aciertos invocan al Unicornio Celeste. Cada error cuesta una vida.'})}
    assignNPCSpecies(d,level=this.level){if(!d?.npcs)return;const usedSpecies=new Set(),allSpecies=[...new Set(Object.values(NPC_SPECIES_BY_BIOME).flat())],fallbackNames={robot:'R-7',mole:'Topo Brum',dwarf:'Borin',golem:'Roca',fox:'Zuri',rabbit:'Milo',fairy:'Luma',goblin:'Grin',armored_owl:'Sir Pluma',penguin:'Pingo',yeti:'Yeta',snowfox:'Niva',salamander:'Ascua',imp:'Chispa',otter:'Oti',turtle:'Tuga',merfolk:'Neri',crabfolk:'Crabi',owl:'Orion',griffin:'Gri',toybot:'Tiko',teddy:'Bombo',clockwork:'Tic',slime:'Gumi',alien:'Vexo',wisp:'Lux',crystalfolk:'Prisma'};for(let i=0;i<d.npcs.length;i++){const n=d.npcs[i];if(n.special==='wizardQuiz'){n.species='wizard';usedSpecies.add('wizard');continue}const biome=n.biome||this.npcBiome(n),pool=NPC_SPECIES_BY_BIOME[biome]||NPC_SPECIES_BY_BIOME.meadow,ordered=[...pool.slice((level+i)%pool.length),...pool.slice(0,(level+i)%pool.length)],candidate=ordered.find(sp=>!usedSpecies.has(sp))||allSpecies.find(sp=>!usedSpecies.has(sp))||ordered[0];n.species=n.species&&!usedSpecies.has(n.species)?n.species:candidate;usedSpecies.add(n.species);if(!n.name||/^NPC|Aldeano/i.test(n.name))n.name=fallbackNames[n.species]||n.name||'Habitante';n.creatureVariant=(level*3+i*5)%5}}
    quizQuestionsForLevel(level=this.level){const out=[],start=(level*7)%QUIZ_BANK.length;for(let i=0;i<QUIZ_BANK.length&&out.length<3;i++){const q=QUIZ_BANK[(start+i*5)%QUIZ_BANK.length];if(!out.includes(q))out.push(q)}return out}
    openWizardQuiz(n){if(this.quizOpen)return;if(n.quizCompleted){this.flash(this.summonType==='unicorn'?'El Unicornio Celeste seguirá con vos hasta el portal.':this.summonType==='joshi'?'Joshi seguirá con vos hasta el final del nivel.':'El desafío ya terminó.',1800);return}this.quizOpen=true;this.paused=true;this.wizardQuiz={npc:n,index:0,correct:0,questions:this.quizQuestionsForLevel(this.level),joshiGranted:false};document.getElementById('wizard-quiz-overlay')?.classList.remove('hidden');this.renderWizardQuiz();setTimeout(()=>document.querySelector('[data-wizard-answer="0"]')?.focus(),0)}
    renderWizardQuiz(){const qz=this.wizardQuiz;if(!qz)return;const q=qz.questions[qz.index];if(!q){this.finishWizardQuiz();return}const title=document.getElementById('wizard-quiz-title'),question=document.getElementById('wizard-quiz-question'),prog=document.getElementById('wizard-quiz-progress');if(title)title.textContent=`Prueba del Mago · Nivel ${this.level}`;if(question)question.textContent=q.q;if(prog)prog.textContent=`Pregunta ${qz.index+1}/3 · ${qz.correct} correctas`;document.querySelectorAll('[data-wizard-answer]').forEach((b,i)=>{b.textContent=q.a[i]||'';b.disabled=false})}
    challengeLifePenalty(){const prof=MC.state.data.profile,set=MC.state.data.settings;prof.lives=Math.max(0,(prof.lives||0)-1);let note='-1 vida';if(prof.lives<=0){if((prof.continues||0)>0){prof.continues--;prof.lives=set.initialLives||3;note='-1 vida · usaste un continue'}else{prof.lives=1;note='-1 vida · última oportunidad'}}MC.state.save();this.updateHUD();return note}
    grantSummon(type){if(type==='joshi'&&this.summonType)return;if(type==='joshi'){this.summonType='joshi';this.hero.speed+=34;this.hero.jump+=55;this.player.doubleJump=Math.max(this.player.doubleJump,2);this.companionSay('¡Joshi se une al equipo! Más salto y velocidad hasta el final del nivel.',3200,true)}else if(type==='unicorn'){this.summonType='unicorn';this.player.doubleJump=Math.max(this.player.doubleJump,3);this.companionSay('¡Perfecto! El Unicornio Celeste respondió al llamado. Podés mantener SALTO en el aire para volar.',3800,true)}this.updateHUD()}
    answerWizard(choice){const qz=this.wizardQuiz;if(!this.quizOpen||!qz)return;const q=qz.questions[qz.index],ok=choice===q.ok;if(ok){qz.correct++;if(!qz.joshiGranted){qz.joshiGranted=true;this.grantSummon('joshi')}this.flash('✓ Respuesta correcta',700)}else{const note=this.challengeLifePenalty();this.flash(`✕ Respuesta incorrecta · ${note}`,1300)}qz.index++;if(qz.index>=3){setTimeout(()=>this.finishWizardQuiz(),450)}else{this.renderWizardQuiz();setTimeout(()=>document.querySelector('[data-wizard-answer="0"]')?.focus(),0)}}
    finishWizardQuiz(){const qz=this.wizardQuiz;if(!qz)return;if(qz.correct===3)this.grantSummon('unicorn');else if(qz.correct>0&&this.summonType!=='joshi')this.grantSummon('joshi');qz.npc.quizCompleted=true;this.closeWizardQuiz(true);this.flash(qz.correct===3?'✦ 3/3 · Unicornio Celeste invocado':qz.correct>0?`✦ ${qz.correct}/3 · Joshi te acompaña`:'El desafío terminó sin invocación',2600)}
    closeWizardQuiz(completed=false){document.getElementById('wizard-quiz-overlay')?.classList.add('hidden');this.quizOpen=false;this.paused=false;if(!completed)this.wizardQuiz=null}
    airJumpCapacity(){const base=MC.state.data.avatar.heroBase==='runner'?2:1;return this.summonType==='unicorn'?Math.max(base,3):this.summonType==='joshi'?Math.max(base,2):base}
    companionSay(text,ms=2200,force=false){if(!force&&this.companionSpeechCd>0)return;this.companionSpeech={text,until:this.time+ms/1000};this.companionSpeechCd=force?.5:1.3}
    updateCompanionReactions(dt){if(this.companionSpeechCd>0)this.companionSpeechCd-=dt;const dead=this.data.enemies.filter(e=>e.dead).length;if(dead>this.lastDeadCount){const lines=['¡Buen golpe!','¡Uno menos! Seguimos.','¡Eso estuvo genial!','¡Excelente! El camino se despeja.'];this.companionSay(lines[(dead+this.level)%lines.length]);this.lastDeadCount=dead}if(this.collectedCubes>this.lastCubeCount){const lines=['¡Cubo conseguido!','¡Bien! Falta menos.','¡Lo encontramos!','¡Ese brillo era nuestro!'];this.companionSay(lines[(this.collectedCubes+this.level)%lines.length]);this.lastCubeCount=this.collectedCubes}if(this.activeQuest?.status==='completed'&&!this.sideQuestCelebrated){this.sideQuestCelebrated=true;this.companionSay('¡Misión opcional completada! Gran trabajo.',2800,true)}if(this.objectiveDone()&&!this.objectiveCelebrated){this.objectiveCelebrated=true;this.companionSay('¡Objetivo completo! Ahora vamos al portal.',3000,true)}}

        levelDesign(level){return MC.levelDesign?MC.levelDesign(level):null}
    safeSpots(d){const fragile=new Set(['moving','elevator','crumble','destructible','block_brick','block_wood','block_glass']);return d.platforms.filter(p=>p.hp!==0&&p.w>=120&&p.y<GROUND+120&&!fragile.has(p.type)&&!p.requiresSignal).sort((a,b)=>a.x-b.x)}
    objectiveLabel(o){if(o.type==='collect')return `Recolectá ${o.target} cubos y llegá al portal`;if(o.type==='defeat')return `Derrotá ${o.target} enemigos y llegá al portal`;if(o.type==='key')return 'Encontrá la llave, abrí la puerta y llegá al portal';if(o.type==='boss')return 'Derrotá al Guardián del mundo';return 'Llegá al portal'}
    applyLevelDesign(d,design,r){
      if(!design)return;d.design=design;d.objective={...design.objective,label:this.objectiveLabel(design.objective)};d.sideQuest={id:`L${design.level}_side`,...design.sideQuest,title:{coins:'Recolectá monedas extra',secret:'Encontrá un secreto',defeat:'Derrotá enemigos opcionales',switch:'Activá mecanismos',break:'Rompé materiales'}[design.sideQuest.type]||'Desafío secundario'};
      const spots=this.safeSpots(d);const firstNpc=d.npcs[0];if(firstNpc){firstNpc.kind=design.npc||firstNpc.kind;firstNpc.id=firstNpc.id||`npc_${design.level}_guide`;firstNpc.text=design.hint;firstNpc.questGiver=true}
      if(design.feature.includes('interior')||String(design.secret).includes('room')||design.secret==='house_interior'||design.secret==='core_interior'){
        const entry=spots[Math.min(spots.length-1,Math.max(1,Math.floor(spots.length*.38)))];if(entry){const link=`ROOM${design.level}`;d.interiorDoors.push({id:`doorin_${design.level}_a`,x:entry.x+Math.min(entry.w-60,80),y:entry.y-95,w:58,h:95,link,label:'ENTRAR'});const rx=Math.min(d.width-850,entry.x+720),ry=330;d.platforms.push({id:`roomfloor_${design.level}`,type:'block_stone',x:rx,y:ry+230,w:520,h:60,baseX:rx,baseY:ry+230,hp:999,indestructible:true,material:'stone'},{id:`roomwall_${design.level}`,type:'block_brick',x:rx,y:ry,w:60,h:230,baseX:rx,baseY:ry,hp:999,indestructible:true,material:'brick'},{id:`roomwall2_${design.level}`,type:'block_brick',x:rx+460,y:ry,w:60,h:230,baseX:rx+460,baseY:ry,hp:999,indestructible:true,material:'brick'});d.interiorDoors.push({id:`doorin_${design.level}_b`,x:rx+90,y:ry+135,w:58,h:95,link,label:'SALIR'});d.chests.push({id:`secret_room_${design.level}`,x:rx+340,y:ry+185,w:58,h:45,secret:true,opened:false,item:design.level%2?'shield':'potion'});}}
      if(['gear_temple','factory_logic','clock_tower','core_walls','portal_chamber'].includes(design.feature)){const p=spots[Math.min(spots.length-1,Math.floor(spots.length*.55))];if(p){const link=`M${design.level}`;d.switches.push({id:`plate_${design.level}`,type:'pressure',x:p.x+40,y:p.y-18,w:55,h:18,link,active:false});d.timers.push({id:`timer_${design.level}`,link,delay:2.5+(design.level%3),phase:0,active:false});}}
      const sp=spots[Math.min(spots.length-1,Math.max(1,Math.floor(spots.length*.72)))];if(sp){d.chests.push({id:`secret_${design.level}`,x:sp.x+Math.max(30,sp.w-100),y:sp.y-46,w:58,h:45,secret:true,opened:false,item:design.sideQuest.reward?.item||'potion'});if(!String(design.secret).includes('room'))d.platforms.push({id:`secretblock_${design.level}`,type:'block_brick',x:sp.x+Math.max(0,sp.w-160),y:sp.y-80,w:80,h:80,baseX:sp.x+Math.max(0,sp.w-160),baseY:sp.y-80,hp:3,material:'brick'});}
      this.applyFeatureKit(d,design,spots,r);this.addThemedNPCs(d,design,spots);
    }
    addThemedNPCs(d,design,spots){if(!spots?.length)return;const f=String(design?.feature||''),world=design?.world||this.world;let roles=['guide','villager'],names=['Lumi','Pico'];if(world===2||/mine|quarry/.test(f)){roles=['mechanic','scout'];names=['Bruna','Talo']}else if(world===3||/castle|ruin|citadel/.test(f)){roles=['guard','villager'];names=['Sir Cubo','Mira']}else if(world===4||/sky|storm|orbit/.test(f)){roles=['scout','inventor'];names=['Nube','Volt']}else if(world===5||/ice|glacier/.test(f)){roles=['villager','guide'];names=['Nika','Polo']}else if(world===6||/toy|dream|candy/.test(f)){roles=['inventor','merchant'];names=['Chispa','Mimi']}else if(world===7||/ocean|marine|swamp|abyss/.test(f)){roles=['sailor','guide'];names=['Coral','Nemo']}else if(world===8||/lava|volcano|core|void/.test(f)){roles=['guard','inventor'];names=['Ferro','Ember']}const used=new Set((d.npcs||[]).map(n=>Math.round(n.x/120)));for(let i=0;i<2;i++){const p=spots[Math.min(spots.length-1,Math.max(1,Math.floor(spots.length*(.28+i*.4))))];if(!p||used.has(Math.round((p.x+p.w*.7)/120)))continue;const kind=roles[i%roles.length],x=p.x+Math.max(55,Math.min(p.w-55,p.w*(i? .72:.35))),y=p.y-88;d.npcs.push({id:`ambient_${design?.level||this.level}_${i}`,x:x-29,y,w:58,h:88,kind,name:names[i],phase:i*1.8,dir:i? -1:1,baseX:x-29,baseY:y,personality:i?'curious':'helpful',questGiver:false,text:i?`Soy ${names[i]}. Si te perdés, preguntame por el objetivo.`:`${names[i]} conoce este lugar y puede orientarte.`});}}
    applyFeatureKit(d,design,spots,r){
      const f=String(design.feature||''),pick=i=>spots[Math.min(Math.max(0,i),Math.max(0,spots.length-1))];if(!spots.length)return;
      const addBlock=(p,type,off=0)=>{if(!p)return;const hp={block_brick:3,block_stone:5,block_wood:2,block_glass:1,block_iron:999,block_obsidian:999}[type]||3,x=p.x+Math.max(20,Math.min(p.w-100,off||p.w*.45));d.platforms.push({id:uid('kit'),type,x,y:p.y-80,w:80,h:80,baseX:x,baseY:p.y-80,hp,indestructible:hp===999,material:type.replace('block_','')})};
      if(/mine|quarry|ruin|citadel|core|wall|avenue/.test(f)){for(const i of [2,5,8])addBlock(pick(i),design.world>=8?'block_iron':i%2?'block_stone':'block_brick')}
      if(/city|block|toy|dream|candy/.test(f)){for(const i of [1,4,7]){const p=pick(i);addBlock(p,i%2?'block_wood':'block_brick');if(p)d.decor.push({type:i%2?'decor_sign':'decor_lamp',x:p.x+p.w*.25,y:p.y-50,text:'EXPLORÁ'})}}
      if(/sky|storm|orbit|neon/.test(f)){for(const i of [2,6,9]){const p=pick(i);if(p)d.platforms.push({id:uid('air'),type:i%2?'moving':'elevator',x:p.x+60,y:p.y-180,w:170,h:28,baseX:p.x+60,baseY:p.y-180,axis:i%2?'x':'y',range:150,speed:1.05,hp:999,material:'signal'})}}
      if(/lava|volcano|elemental/.test(f)){const p=pick(5);if(p)d.lavas.push({x:p.x+40,y:p.y+15,w:Math.min(300,Math.max(150,p.w-80)),h:115})}
      if(/ice|glacier/.test(f)){for(const i of [3,7]){const p=pick(i);if(p)d.platforms.push({id:uid('ice'),type:'ice',x:p.x+30,y:p.y-110,w:Math.min(220,p.w-60),h:34,baseX:p.x+30,baseY:p.y-110,hp:999,material:'ice'})}}
      if(/swamp|ocean|marine|abyss/.test(f)){const p=pick(6);if(p){const wx=p.x,wy=p.y-20,ww=Math.min(520,Math.max(300,p.w+180));d.waters.push({x:wx,y:wy,w:ww,h:250});const marine=['fish','jellyfish','seahorse'];marine.forEach((type,j)=>{const sp=enemySpec(type),mx=wx+90+j*110,my=wy+90+j*35;d.enemies.push({id:uid('marine'),x:mx,y:my,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type,phase:j,baseX:mx,baseY:my,dir:j%2?1:-1,shotCd:1,state:'swim',objective:false})});d.decor.push({type:'decor_coral',x:wx+100,y:wy+210,color:'#ff7bb5'},{type:'decor_seaweed',x:wx+230,y:wy+205},{type:'decor_bubbles',x:wx+350,y:wy+110})}}
      if(/factory|gear|clock|circuit|portal/.test(f)){const p=pick(7);if(p){const link=`SIG${design.level}`;d.switches.push({id:uid('sw'),type:'pressure',x:p.x+20,y:p.y-18,w:55,h:18,link,active:false});d.platforms.push({id:uid('sig'),type:'moving',x:p.x+120,y:p.y-150,w:180,h:28,baseX:p.x+120,baseY:p.y-150,axis:'y',range:130,speed:1,link,requiresSignal:true,hp:999,material:'signal'})}}
    }
    ensureObjectiveIntegrity(d){
      d.integrity=d.integrity||{repairs:[]};const o=d.objective||{type:'reach',target:1};const spots=this.safeSpots(d);const choose=i=>spots.length?spots[Math.min(spots.length-1,Math.max(0,i%spots.length))]:{x:300+i*300,y:GROUND,w:300,h:40};
      if(o.type==='collect'){
        o.target=Math.max(1,+o.target||3);
        const route=spots.filter(p=>p.x>d.spawn.x+120&&p.x<d.goal.x-80&&p.w>=150),pool=route.length?route:spots;
        if(d.handcrafted){
          while(d.cubes.length<o.target){const i=d.cubes.length,p=pool.length?pool[Math.min(pool.length-1,i%pool.length)]:choose(i+1);d.cubes.push({id:uid('repaircube'),x:p.x+Math.max(55,Math.min(p.w-55,p.w*.5)),y:p.y-74,got:false,objective:true,mission:true,autoRepair:true});d.integrity.repairs.push('cubo de misión añadido automáticamente')}
          d.cubes.forEach((c,i)=>{c.id=c.id||uid('missioncube');c.got=false;c.objective=i<o.target;c.mission=i<o.target});
        }else if(d.isCustom){
          while(d.cubes.length<o.target){const i=d.cubes.length,p=pool.length?pool[Math.min(pool.length-1,i%pool.length)]:choose(i+1);d.cubes.push({id:uid('repaircube'),x:p.x+Math.max(55,Math.min(p.w-55,p.w*.5)),y:p.y-74,got:false,objective:true,mission:true,autoRepair:true});d.integrity.repairs.push('cubo de misión añadido automáticamente')}
          d.cubes.forEach((c,i)=>{c.objective=i<o.target;c.mission=i<o.target});
        }else{
          while(d.cubes.length<o.target)d.cubes.push({id:uid('repaircube'),x:0,y:0,got:false,objective:true});
          d.cubes.forEach((c,i)=>c.objective=i<o.target);
          for(let i=0;i<o.target;i++){const c=d.cubes[i],idx=pool.length?Math.min(pool.length-1,Math.max(0,Math.round((i+1)*pool.length/(o.target+1))-1)):0,p=pool[idx]||choose(i*2+2);c.id=c.id||uid('missioncube');c.x=p.x+Math.max(55,Math.min(p.w-55,p.w*(.34+.28*(i%2))));c.y=p.y-74;c.got=false;c.objective=true;c.mission=true;}
          if(d.cubes.length>o.target)for(let i=o.target;i<d.cubes.length;i++)d.cubes[i].objective=false;
        }
      }
      if(o.type==='defeat'){o.target=Math.max(1,+o.target||3);let eligible=d.enemies.filter(e=>e.type!=='boss');while(eligible.length<o.target){const p=choose(eligible.length*2+3),sp=enemySpec(eligible.length%2?'hopper':'blob'),e={id:uid('repairenemy'),x:p.x+Math.min(p.w-70,80),y:p.y-sp.h,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type:eligible.length%2?'hopper':'blob',phase:eligible.length,baseX:p.x+80,baseY:p.y-sp.h,dir:1,shotCd:1,state:'idle',objective:true};d.enemies.push(e);eligible.push(e);d.integrity.repairs.push('enemigo añadido')}eligible.forEach((e,i)=>e.objective=i<o.target);}
      if(o.type==='key'){const kp=choose(3);if(!d.keys.length){d.keys.push({id:uid('repairkey'),x:kp.x+Math.min(kp.w-70,90),y:kp.y-58,w:48,h:48,link:'AUTO',got:false});d.integrity.repairs.push('llave añadida')}else{const k=d.keys[0];k.w=48;k.h=48;k.got=false;k.link=k.link||'AUTO';if(!d.handcrafted){k.x=kp.x+Math.min(kp.w-70,90);k.y=kp.y-58}}const dp=choose(Math.max(4,spots.length-2)),link=d.keys[0].link||'AUTO',door=d.doors.find(x=>x.link===link);if(!door){d.doors.push({id:uid('repairdoor'),x:dp.x+Math.max(10,dp.w-85),y:dp.y-150,w:72,h:150,link,open:false});d.integrity.repairs.push('puerta añadida')}else{door.open=false;if(!d.handcrafted){door.x=dp.x+Math.max(10,dp.w-85);door.y=dp.y-150}}}
      o.label=this.objectiveLabel(o);return d;
    }
    computeWorldBounds(d){
      const boxes=[],add=(x,y,w=0,h=0)=>{if(Number.isFinite(x)&&Number.isFinite(y))boxes.push({x,y,w:+w||0,h:+h||0})};
      for(const q of d.platforms||[])add(q.x,q.y,q.w,q.h);for(const q of d.waters||[])add(q.x,q.y,q.w,q.h);for(const q of d.lavas||[])add(q.x,q.y,q.w,q.h);for(const q of d.hazards||[])add(q.x,q.y,q.w,q.h);for(const q of d.enemies||[])add(q.x,q.y,q.w,q.h);for(const q of d.npcs||[])add(q.x,q.y,q.w,q.h);for(const q of d.cubes||[])add(q.x-24,q.y-24,48,48);for(const q of d.coins||[])add(q.x-20,q.y-20,40,40);for(const q of d.decor||[])add(q.x-80,q.y-100,160,200);for(const q of d.interiorDoors||[])add(q.x,q.y,q.w,q.h);for(const q of d.logicGates||[])add(q.x,q.y,q.w,q.h);for(const q of d.signalLamps||[])add(q.x,q.y,q.w,q.h);if(d.goal)add(d.goal.x,d.goal.y,d.goal.w,d.goal.h);if(d.spawn)add(d.spawn.x-40,d.spawn.y-120,80,160);
      const minY=boxes.length?Math.min(...boxes.map(b=>b.y)):-200,maxY=boxes.length?Math.max(...boxes.map(b=>b.y+b.h)):GROUND+300,minX=boxes.length?Math.min(...boxes.map(b=>b.x)):0,maxX=boxes.length?Math.max(...boxes.map(b=>b.x+b.w)):d.width;
      d.minY=Math.min(-180,minY-220);d.maxY=Math.max(GROUND+260,maxY+260);d.width=Math.max(d.width||0,maxX+500,2800);d.minX=Math.min(0,minX-200);d.height=d.maxY-d.minY;return d;
    }
    objectiveTarget(){const o=this.data.objective;if(o.type==='collect')return this.data.cubes.find(c=>c.objective!==false&&!c.got)||null;if(o.type==='defeat')return this.data.enemies.find(e=>!e.dead&&e.type!=='boss'&&e.objective!==false)||null;if(o.type==='key')return this.data.keys.find(k=>!k.got)||null;if(o.type==='boss')return this.data.enemies.find(e=>e.type==='boss'&&!e.dead)||null;return this.data.goal||null}
    relativeDirectionTo(x,y){const p=this.player,dx=x-(p.x+p.w/2),dy=y-(p.y+p.h/2),h=Math.abs(dx)<180?'cerca':dx>0?'a la derecha':'a la izquierda',v=Math.abs(dy)<120?'a tu altura':dy>0?'más abajo':'más arriba';return `${h}, ${v}`}
    buildCustom(source){
      const project=Array.isArray(source)?{objects:source,spawn:{x:120,y:500}}:source,d=this.blankData(),objs=project.objects||[];d.spawn=project.spawn||{x:120,y:500};let maxX=2800;
      for(const o0 of objs){const o={...o0};maxX=Math.max(maxX,o.x+(o.w||200)+600);const type=o.type;
        if(['platform','semisolid','moving','elevator','destructible','ice','crumble','conveyor','bounce','block_brick','block_stone','block_iron','block_wood','block_glass','block_obsidian'].includes(type)){const hpDefaults={destructible:3,block_brick:3,block_stone:5,block_wood:2,block_glass:1,block_iron:999,block_obsidian:999};
          d.platforms.push({id:o.id||uid('p'),type,x:o.x,y:o.y,w:o.w||180,h:o.h||40,baseX:o.x,baseY:o.y,axis:type==='elevator'?'y':(o.axis||'x'),range:o.range||240,speed:o.speed||1.2,hp:o.hp??hpDefaults[type]??999,indestructible:o.indestructible??['block_iron','block_obsidian'].includes(type),material:o.material||type.replace('block_','')||'grass',crumbleTimer:null});}
        else if(type==='coin')d.coins.push({x:o.x,y:o.y,got:false});else if(type==='cube')d.cubes.push({x:o.x,y:o.y,got:false});
        else if(type.startsWith('enemy_')||['fish','shark','jellyfish','eel','seahorse','crab'].includes(type)){const et=type.replace('enemy_',''),sp=enemySpec(et);d.enemies.push({id:o.id||uid('e'),x:o.x,y:o.y,w:sp.w,h:sp.h,hp:o.hp||sp.hp,maxHp:o.hp||sp.hp,dead:false,type:et,phase:0,baseX:o.x,baseY:o.y,dir:o.direction||1,shotCd:1,state:'idle'});}
        else if(type==='spring')d.springs.push({x:o.x-28,y:o.y-14,w:58,h:28});else if(type==='water')d.waters.push({x:o.x,y:o.y,w:o.w||200,h:o.h||100});else if(type==='lava')d.lavas.push({x:o.x,y:o.y,w:o.w||200,h:o.h||90});
        else if(type==='spikes')d.hazards.push({type:'spikes',x:o.x-40,y:o.y-15,w:80,h:30});else if(type==='fire')d.hazards.push({type:'fire',x:o.x-32,y:o.y-45,w:64,h:50});else if(type==='saw')d.hazards.push({type:'saw',x:o.x-31,y:o.y-31,w:62,h:62,phase:0});else if(type==='key')d.keys.push({...o,w:48,h:48,got:false,x:o.x-24,y:o.y-24});
        else if(type==='door')d.doors.push({...o,w:o.w||70,h:o.h||130,open:false});else if(type==='switch'||type==='pressure_plate')d.switches.push({...o,type:type==='pressure_plate'?'pressure':'switch',w:type==='pressure_plate'?60:50,h:type==='pressure_plate'?18:26,active:false,x:o.x-(type==='pressure_plate'?30:25),y:o.y-(type==='pressure_plate'?9:13)});else if(type==='timer_switch')d.timers.push({...o,delay:+o.delay||3,phase:0,active:false});else if(['logic_and','logic_or','logic_not'].includes(type))d.logicGates.push({...o,type:type.replace('logic_',''),x:o.x-35,y:o.y-24,w:70,h:48,link:o.link||'C',inputs:String(o.text||'A,B')});else if(type==='signal_lamp')d.signalLamps.push({...o,x:o.x-25,y:o.y-40,w:50,h:80,link:o.link||'A'});
        else if(type==='checkpoint')d.checkpoints.push({x:o.x-24,y:o.y-50,w:48,h:100,active:false});else if(type==='chest'||type==='secret_chest')d.chests.push({...o,w:58,h:45,x:o.x-29,y:o.y-22,opened:false,secret:type==='secret_chest',item:o.item||'potion'});else if(type==='interior_door')d.interiorDoors.push({...o,w:58,h:95,x:o.x-29,y:o.y-48,link:o.link||'ROOM',label:o.text||'ENTRAR'});else if(type==='npc'||type.startsWith('npc_'))d.npcs.push({...o,w:58,h:88,x:o.x-29,y:o.y-44,kind:type.replace('npc_','')==='npc'?'guide':type.replace('npc_',''),phase:Math.random()*6,dir:1});
        else if(type==='portal')d.goal={x:o.x-45,y:o.y-80,w:90,h:160};else if(type==='signal_platform'){d.platforms.push({id:o.id||uid('sigp'),type:'moving',x:o.x,y:o.y,w:o.w||180,h:o.h||30,baseX:o.x,baseY:o.y,axis:o.axis||'x',range:o.range||220,speed:o.speed||1,link:o.link||'A',requiresSignal:true,hp:999,material:'signal'});}else if(type==='spawn')d.spawn={x:o.x,y:o.y};else if(type.startsWith('decor_'))d.decor.push(o);
      }
      d.width=maxX;d.isCustom=true;const po=project.objective||{};d.objective=po.type?{type:po.type,target:Math.max(1,+po.target||1),label:''}:(d.cubes.length?{type:'collect',target:Math.max(1,Math.min(3,d.cubes.length)),label:''}:{type:'reach',target:1,label:''});d.sideQuest=project.sideQuest||null;this.ensureObjectiveIntegrity(d);d.objective.label=this.objectiveLabel(d.objective);this.computeWorldBounds(d);return d;
    }
    prepareSideQuest(){const q=this.data.sideQuest;if(!q)return null;const saved=MC.state.getQuest(q.id);if(saved?.status==='completed')return{...q,status:'completed',progress:q.target};if(saved?.status==='active')return{...q,...saved};return{...q,status:'inactive',progress:0}}
    activateSideQuest(){if(!this.activeQuest||this.activeQuest.status!=='inactive')return;this.activeQuest.status='active';MC.state.setQuest(this.activeQuest.id,{...this.activeQuest,status:'active'});this.flash(`◇ Misión secundaria: ${this.activeQuest.title}`,2400)}
    sideQuestProgress(){const q=this.activeQuest;if(!q)return 0;if(q.type==='coins')return this.scoreCoins;if(q.type==='secret')return this.runSecrets;if(q.type==='defeat')return this.data.enemies.filter(e=>e.dead&&e.type!=='boss').length;if(q.type==='switch')return this.switches.size;if(q.type==='break')return this.brokenBlocks;return 0}
    updateSideQuest(){const q=this.activeQuest;if(!q||q.status!=='active')return;const progress=Math.min(q.target,this.sideQuestProgress());q.progress=progress;MC.state.setQuest(q.id,{...q,progress});if(progress>=q.target){q.status='completed';const reward=q.reward||{};if(reward.coins)MC.state.addCoins(reward.coins);if(reward.item)MC.state.addItem(reward.item,1);let gearName='';if(reward.gear){MC.state.addGear(reward.gear);gearName=MC.GEAR_CATALOG?.[reward.gear]?.name||reward.gear}if(q.chain){const chainId=`chain:${q.chain}`,prev=MC.state.getQuest(chainId)||{};MC.state.setQuest(chainId,{...prev,status:q.step>=5?'completed':'active',step:Math.max(prev.step||0,q.step||0),progress:Math.max(prev.progress||0,q.step||0),target:5})}MC.state.setQuest(q.id,{...q,status:'completed',progress:q.target});this.flash(`★ Misión secundaria completada · +${reward.coins||0} monedas${reward.item?' · '+reward.item:''}${gearName?' · '+gearName:''}`,3400)}}
    directionTo(x){const dx=x-(this.player.x+this.player.w/2),ad=Math.abs(dx);return `${dx>=0?'a la derecha':'a la izquierda'} · ${ad<350?'muy cerca':ad<900?'cerca':'más adelante'}`}
    mineChainStatus(){const q=MC.state.getQuest('chain:mine')||{step:0,status:'inactive'};return {step:+q.step||0,status:q.status||'inactive'}}
    mineChainLine(n){if(n.chain!=='mine')return '';const st=this.mineChainStatus(),step=n.chainStep||Math.max(1,this.level-5);if(st.status==='completed')return ' La expedición de la Mina Resonante quedó completa; el equipo recuperado sigue en tu inventario.';if(st.step>=step)return ' Ya recuerdo lo que hiciste en el tramo anterior. Esta parte de la expedición continúa desde ahí.';if(step===1)return ' Esta es la primera tarea de la expedición minera.';return ` Esta tarea pertenece al paso ${step}/5 de la expedición; completar las anteriores desbloquea todo su equipo.`}
    npcMessage(n){const o=this.data.objective,[a,b]=this.objectiveProgress();const mem=MC.state.dialogMemory(this.level,n.id||n.kind),remaining=Math.max(0,b-a);let msg=n.text||this.data.design?.hint||'Explorá con atención.';if(this.objectiveDone())msg='El objetivo principal ya está completo. El portal está listo: seguí hacia la salida.';else if(o.type==='collect'){const t=this.data.cubes.find(c=>!c.got);msg=t?`Te faltan ${remaining} cubo${remaining===1?'':'s'}. El sensor marca uno ${this.relativeDirectionTo(t.x,t.y)}. Seguí el indicador ◆.`:'Los cubos deberían estar completos. Revisá el portal.'}else if(o.type==='defeat'){const t=this.data.enemies.find(e=>!e.dead&&e.type!=='boss'&&e.objective!==false);msg=t?`Quedan ${remaining} enemigos del objetivo. El más cercano está ${this.relativeDirectionTo(t.x,t.y)}.`:'No detecto enemigos pendientes. Andá al portal.'}else if(o.type==='key'){const k=this.data.keys.find(k=>!k.got);msg=k?`La llave está ${this.directionTo(k.x)}.`:'Ya tenés la llave. Buscá la puerta vinculada y seguí al portal.'}else if(o.type==='boss'){const bss=this.data.enemies.find(e=>e.type==='boss'&&!e.dead);msg=bss?`El Guardián está ${this.directionTo(bss.x)}. Cambia de patrón al 66% y 33% de vida.`:'El Guardián cayó. El portal está habilitado.'}else msg=`El portal está ${this.directionTo(this.data.goal.x)}.`;if(mem.talks===0&&this.data.design?.hint)msg=this.data.design.hint+' '+msg;else if(mem.talks>0&&!this.objectiveDone()){const extras=['Mirá el indicador de misión: siempre apunta al objetivo pendiente.','Podés explorar arriba y abajo: la cámara ahora sigue toda la altura del mundo.','Si algo parece perdido, volvé a hablar conmigo y te marco la dirección.'];msg+=' '+extras[mem.talks%extras.length]}msg+=this.mineChainLine(n);if(this.activeQuest?.status==='inactive'&&n.questGiver!==false)msg+=' Tengo además un desafío opcional para vos.';const flavor={robot:'Mis sensores confirman la ruta.',mole:'Huelo túneles y secretos bajo tus pies.',dwarf:'La piedra habla si sabés escucharla.',golem:'Piedra firme. Paso seguro.',fox:'Si ves un desvío, quizá esconda algo divertido.',rabbit:'¡Yo siempre busco la ruta más rápida!',fairy:'Las luces pequeñas suelen señalar secretos.',goblin:'Je, je... los atajos están donde nadie mira.',penguin:'En el hielo conviene medir cada salto.',yeti:'Los caminos altos no me asustan.',snowfox:'Las huellas cuentan por dónde pasó alguien.',salamander:'Cerca del fuego, mirá bien dónde pisás.',imp:'¡Las cosas calientes suelen esconder sorpresas!',otter:'El agua también puede ser un camino.',turtle:'Despacio también se llega lejos.',merfolk:'Bajo el agua, mirá arriba y abajo.',crabfolk:'De costado también se descubren secretos.',owl:'Desde arriba se entiende mejor el mapa.',armored_owl:'Primero observá; después atacá.',griffin:'El cielo tiene más de una ruta.',toybot:'¡Bip! Juego detectado. Diversión probable.',teddy:'No todo desafío tiene que dar miedo.',clockwork:'Cada mecanismo tiene su momento.',slime:'¡Bloop! Seguí avanzando.',alien:'Este mundo tiene patrones interesantes.',wisp:'La luz te acompaña donde el camino se oscurece.',crystalfolk:'Los cristales vibran cerca de rutas ocultas.'}[n.species];if(flavor&&mem.talks%2===1)msg+=' '+flavor;return msg}
    talkTo(n){if(n.special==='wizardQuiz'){this.openWizardQuiz(n);n.talkCd=1.2;return}this.activateSideQuest();const id=n.id||n.kind||'npc',mem=MC.state.dialogMemory(this.level,id),msg=this.npcMessage(n);MC.state.rememberDialog(this.level,id,{talks:(mem.talks||0)+1,last:msg});n.talkCd=1.2;this.flash(msg,4300)}
    toggleInventory(force){this.inventoryOpen=typeof force==='boolean'?force:!this.inventoryOpen;const ov=document.getElementById('inventory-overlay');ov?.classList.toggle('hidden',!this.inventoryOpen);this.paused=this.inventoryOpen||this.paused;if(this.inventoryOpen)this.renderInventory();else if(document.getElementById('pause-overlay')?.classList.contains('hidden'))this.paused=false}
    renderInventory(){const box=document.getElementById('inventory-items');if(!box)return;const defs={potion:['🧪','Poción','Recupera 2 corazones'],shield:['🛡️','Escudo Prisma','6 s de escudo'],magnet:['🧲','Imán Nova','15 s: atrae monedas y cubos'],bomb:['💣','Bomba cúbica','Daña enemigos y bloques cercanos'],relic:['💎','Reliquia','Objeto de misión / colección']};box.innerHTML='';for(const [id,[icon,name,desc]] of Object.entries(defs)){const n=MC.state.data.inventory.items[id]||0,d=document.createElement('button');d.className='inventory-item';d.disabled=n<=0||id==='relic';d.innerHTML=`<span>${icon}</span><b>${name}</b><small>${desc}</small><em>x${n}</em>`;d.onclick=()=>this.useInventoryItem(id);box.appendChild(d)}const materialIcons={grass:'🌿',wood:'🪵',brick:'🧱',stone:'🪨',iron:'⬡',metal:'🔩',glass:'◇',crystal:'💎',obsidian:'◆'},materials=MC.state.data.inventory.materials||{};for(const mat of this.buildMaterials||this.buildMaterialOptions(this.world)){const n=materials[mat]||0,d=document.createElement('button'),active=(this.buildMaterials||[])[this.buildMaterialIndex||0]===mat;d.className='inventory-item material-item'+(active?' equipped':'');d.disabled=n<=0;d.innerHTML=`<span>${materialIcons[mat]||'▦'}</span><b>${this.materialLabel(mat)}</b><small>Material de construcción</small><em>${active?'SELECCIONADO · ':''}x${n}</em>`;d.onclick=()=>{const i=(this.buildMaterials||[]).indexOf(mat);if(i>=0){this.buildMaterialIndex=i;this.updateHUD();this.flash('Material: '+this.materialLabel(mat),900);this.renderInventory()}};box.appendChild(d)}const gear=MC.GEAR_CATALOG||{},owned=MC.state.data.inventory.gearOwned||[],eq=MC.state.data.inventory.equippedGear||{};for(const id of owned){const g=gear[id];if(!g)continue;const d=document.createElement('button'),active=eq[g.slot]===id;d.className='inventory-item gear-item'+(active?' equipped':'');d.innerHTML=`<span>${g.icon}</span><b>${g.name}</b><small>${g.desc}</small><em>${active?'EQUIPADO':'EQUIPAR · '+g.slot.toUpperCase()}</em>`;d.oncl