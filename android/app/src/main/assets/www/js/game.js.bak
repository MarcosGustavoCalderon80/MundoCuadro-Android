        const gap=70+Math.floor(r()*105),ww=230+Math.floor(r()*300);x+=gap;y=GROUND-([0,0,55,90,130,170][Math.floor(r()*6)]);
        const roll=r();let ptype='platform';if(this.world===5&&roll>.72)ptype='ice';else if(level>=10&&roll>.94)ptype='bounce';else if(level>=8&&roll>.90)ptype='conveyor';else if(level>=6&&roll>.86)ptype='crumble';else if(roll>.80)ptype='moving';else if(roll>.74)ptype='semisolid';else if(roll>.69)ptype='destructible';
        const p={id:uid('p'),type:ptype,x,y,w:ww,h:['semisolid','moving','conveyor','bounce','crumble'].includes(ptype)?32:120,material:this.world===5?'stone':'grass',baseX:x,baseY:y,axis:r()>.5?'x':'y',range:140+Math.floor(r()*160),speed:.7+r()*1.2,hp:ptype==='destructible'?3:999};d.platforms.push(p);
        if(r()>.42){const kinds=['decor_tree','decor_bush','decor_flower','decor_rock','decor_lamp'],kind=kinds[Math.floor(r()*kinds.length)];d.decor.push({type:kind,x:x+Math.max(35,Math.min(ww-35,30+r()*(ww-60))),y:y-(kind==='decor_tree'?78:kind==='decor_lamp'?55:18),color:['#67e8ff','#ff76c9','#ffd55d'][Math.floor(r()*3)]})}
        if(level>=2&&ww>260&&r()>.78){const mats=this.world>=8?['block_iron','block_obsidian','block_stone']:this.world>=3?['block_stone','block_brick','block_iron']:['block_brick','block_wood','block_stone'],bt=mats[Math.floor(r()*mats.length)],hp={block_brick:3,block_wood:2,block_stone:5,block_iron:999,block_obsidian:999}[bt],bx=x+this.gridLike(Math.max(40,Math.min(ww-120,ww*(.25+r()*.35))),40);d.platforms.push({id:uid('mat'),type:bt,x:bx,y:y-80,w:80,h:80,baseX:bx,baseY:y-80,hp,indestructible:hp===999,material:bt.replace('block_','')});}
        const n=2+Math.floor(r()*5);for(let c=0;c<n;c++)d.coins.push({x:x+40+c*(ww-80)/Math.max(1,n-1),y:y-55,got:false});
        if(i%4===1)d.cubes.push({x:x+ww*.55,y:y-110,got:false});
        if(i>1&&r()>.32){const pool=this.world<2?['blob','blob','hopper','charger','drone']:this.world<5?['blob','hopper','charger','drone','guard','turret','bat']:['charger','drone','guard','turret','bat'];const type=pool[Math.floor(r()*pool.length)],sp=enemySpec(type),ex=x+ww*.55,ey=y-sp.h;d.enemies.push({id:uid('e'),x:ex,y:ey,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type,phase:r()*6,baseX:ex,baseY:ey,dir:r()>.5?1:-1,shotCd:.5+r()*2,state:'idle'});}
        if(r()>.88)d.springs.push({x:x+ww*.18,y:y-25,w:55,h:25});
        if(r()>.9)d.hazards.push({type:'spikes',x:x+ww*.68,y:y-30,w:80,h:30});if(this.world>=3&&r()>.94)d.hazards.push({type:r()>.5?'fire':'saw',x:x+ww*.35,y:y-50,w:64,h:50,phase:r()*6});
        if(this.world===5&&r()>.84)d.lavas.push({x:x+ww*.25,y:y,w:ww*.45,h:130});
        if((this.world===1||this.world===7)&&r()>.86)d.waters.push({x:x+ww*.55,y:y-10,w:ww*.42,h:170});
        if(i===Math.floor(segments*.45))d.checkpoints.push({x:x+ww*.25,y:y-100,w:48,h:100,active:false});
        x+=ww;
