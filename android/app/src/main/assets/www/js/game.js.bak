      const npc=(id,kind,x,y,text,questGiver=false,name='')=>d.npcs.push({id,kind,x:x-29,y:y-88,w:58,h:88,baseX:x-29,baseY:y-88,phase:r()*4,dir:1,text,questGiver,name});
      const tree=(x,y)=>d.decor.push({type:'decor_tree',x,y:y-82,color:'#5fbd6a'}), bush=(x,y)=>d.decor.push({type:'decor_bush',x,y:y-20,color:'#4fba62'}), flower=(x,y)=>d.decor.push({type:'decor_flower',x,y:y-12,color:['#ff76b7','#ffd35e','#7ee8ff'][Math.floor(r()*3)]});
