    update(dt){
      const p=this.player;this.time+=dt;if(p.inv>0)p.inv-=dt;if(p.shield>0)p.shield-=dt;if(this.magnetTime>0)this.magnetTime-=dt;if(this.attackCd>0)this.attackCd-=dt;if(this.abilityCd>0)this.abilityCd-=dt;if(this.dashCd>0)this.dashCd-=dt;if(this.buildCd>0)this.buildCd-=dt;if(this.dropThroughTimer>0){this.dropThroughTimer-=dt;if(this.dropThroughTimer<=0)this.dropThroughId=null;}
