      const solids=this.activePlatforms();
      for(const q of solids){if(!q.solid)continue;if(this.dropThroughTimer>0&&q.id===this.dropThroughId)continue;const sem=q.type==='semisolid';if(nx+p.w>q.x&&nx<q.x+q.w&&oldBottom<=q.y+8&&newBottom>=q.y&&p.vy>=0){ny=q.y-p.h;const wasPound=p.groundPound;p.vy=0;p.onGround=true;p.doubleJump=this.airJumpCapacity();if(wasPound)this.groundPoundImpact(q);p.standingOnId=q.id||null;if(q.type==='conveyor')nx+=(q.speed||1)*150*dt;if(q.type==='bounce'){p.vy=-Math.max(980,this.hero.jump*1.1);p.onGround=false;p.standingOnId=null}if(q.type==='crumble'){const orig=this.data.platforms.find(z=>z.id===q.id);if(orig&&orig.crumbleTimer==null)orig.crumbleTimer=.65;}break}if(!sem&&hit({x:nx,y:ny,w:p.w,h:p.h},q)){if(p.vx>0)nx=q.x-p.w;else if(p.vx<0)nx=q.x+q.w;p.vx=0}}
      for(const door of this.data.doors){if(door.open)continue;if(hit({x:nx,y:ny,w:p.w,h:p.h},door)){if(p.vx>0)nx=door.x-p.w;else if(p.vx<0)nx=door.x+door.w;p.vx=0}}
      for(const s of this.data.springs){if(nx+p.w>s.x&&nx<s.x+s.w&&oldBottom<=s.y+10&&newBottom>=s.y&&p.vy>=0){ny=s.y-p.h;p.vy=-1080;p.onGround=false}}
      p.x=nx;p.y=ny;if(p.y>(this.data.maxY||H+380)+260)this.fallDeath();
