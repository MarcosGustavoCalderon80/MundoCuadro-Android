    refreshGearEffects(){if(!this.player)return;const base=HERO[MC.state.data.avatar.heroBase]||HERO.explorer,gear=MC.state.gearBonuses?MC.state.gearBonuses():{},diff=MC.state.data.settings.difficulty||'normal',hpBonus=diff==='casual'?1:diff==='challenge'?-1:0,newMax=Math.max(3,base.hp+(gear.hp||0)+hpBonus);this.gearBonus=gear;this.hero={...base,hp:base.hp+(gear.hp||0),speed:base.speed+(gear.speed||0),jump:base.jump+(gear.jump||0),damage:base.damage+(gear.damage||0),cadence:Math.max(.11,base.cadence+(gear.cadence||0))};const oldMax=this.player.maxHp||newMax;this.player.maxHp=newMax;this.player.hp=Math.max(1,Math.min(newMax,this.player.hp+Math.max(0,newMax-oldMax)));if(gear.magnet)this.magnetTime=Math.max(this.magnetTime||0,gear.magnet);this.updateHUD()}
    useInventoryItem(id){const p=this.player;if(id==='potion'&&p.hp>=p.maxHp){this.flash('Ya tenés la vida completa');return}if(!MC.state.consumeItem(id,1))return;if(id==='potion')p.hp=Math.min(p.maxHp,p.hp+2);if(id==='shield')p.shield=Math.max(p.shield,6);if(id==='magnet')this.magnetTime=15;if(id==='bomb'){for(const e of this.data.enemies){if(!e.dead&&Math.abs(e.x-p.x)<330){e.hp-=4;if(e.hp<=0)e.dead=true}}for(const q of this.data.platforms){if(!q.indestructible&&q.hp>0&&Math.abs(q.x-p.x)<300&&['destructible','block_brick','block_stone','block_wood','block_glass'].includes(q.type)){q.hp-=4+(this.gearBonus?.breakPower||0);if(q.hp<=0){q.hp=0;this.brokenBlocks++;this.grantMaterialFromBlock(q,1)}}}this.burst(p.x+p.w/2,p.y+p.h/2,'#ffd45d',28)}this.renderInventory();this.updateHUD()}
    updateMechanisms(dt){for(const t of this.data.timers||[]){t.phase=(t.phase||0)+dt;const active=(t.phase%(Math.max(1,+t.delay||3)*2))<(+t.delay||3);t.active=active;if(active)this.switches.add(t.link||'A');else this.switches.delete(t.link||'A')}for(const s of this.data.switches||[]){if(s.type==='pressure'){const on=hit(this.player,s);s.active=on;if(on)this.switches.add(s.link||'A');else this.switches.delete(s.link||'A')}}for(let pass=0;pass<3;pass++){for(const g of this.data.logicGates||[]){const inputs=String(g.inputs||g.text||'A').split(/[,+;\s]+/).filter(Boolean),vals=inputs.map(k=>this.switches.has(k)||this.keysOwned.has(k));let on=false;if(g.type==='and')on=vals.length>0&&vals.every(Boolean);else if(g.type==='or')on=vals.some(Boolean);else if(g.type==='not')on=!vals[0];g.active=on;if(on)this.switches.add(g.link||'C');else this.switches.delete(g.link||'C')}}for(const d of this.data.doors)d.open=this.keysOwned.has(d.link||'A')||this.switches.has(d.link||'A')||d.open} 
