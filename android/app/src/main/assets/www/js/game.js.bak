        d.goal={x:portalPlatform.x+150,y:portalPlatform.y-160,w:90,h:160};d.minY=Math.min(d.minY??-260,GROUND-940);coins(startX+20,GROUND-225,4);coins(startX+610,GROUND-555,4);coins(startX+1210,GROUND-765,5);
      }else if(mode===0){
