    }

    shapeCampaignDestination(d,level=this.level){
      if(!d||d.isCustom||d._destinationShaped)return;d._destinationShaped=true;
      const pal=WORLD_MATERIALS[Math.max(1,Math.min(8,Math.ceil(level/5)))]||WORLD_MATERIALS[1],oldGoal={...(d.goal||{x:(d.width||5200)-300,y:GROUND-160,w:90,h:160})},mode=level%4,startX=Math.max(oldGoal.x+100,(d.width||5200)-240),baseW=d.width||5200;
