    }
    setCrouch(want){const p=this.player;if(!p)return;if(want&&!p.crouching){p.crouching=true;p.y+=p.standH-p.crouchH;p.h=p.crouchH;return}if(!want&&p.crouching){const newY=p.y-(p.standH-p.crouchH),box={x:p.x,y:newY,w:p.w,h:p.standH};const blocked=this.activePlatforms().some(q=>q.type!=='semisolid'&&hit(box,q))||this.data.doors.some(d=>!d.open&&hit(box,d));if(!blocked){p.y=newY;p.h=p.standH;p.crouching=false}}}
        activePlatforms(){const arr=this.data.platforms.filter(q=>q.hp!==0).map(q=>({...q,solid:true}));for(const t of this.tempPlatforms){if(t.life>0)arr.push({...t,type:'semisolid',solid:true})}return arr}
    updatePlatforms(dt){for(const q of this.data.platforms){q.deltaX=0;q.deltaY=0;if(q.type==='moving'||q.type==='elevator'){if(q.requiresSignal&&!this.switches.has(q.link||'A'))continue;const oldX=q.x,oldY=q.y,off=Math.sin(this.time*q.speed)*q.range;q.x=q.axis==='x'?q.baseX+off:q.baseX;q.y=q.axis==='y'?q.baseY+off:q.baseY;q.deltaX=q.x-oldX;q.deltaY=q.y-oldY}if(q.type==='crumble'&&q.crumbleTimer!=null&&q.hp!==0){q.crumbleTimer-=dt;if(q.crumbleTimer<=0)q.hp=0}}for(const t of this.tempPlatforms)t.life-=dt;this.tempPlatforms=this.tempPlatforms.filter(t=>t.life>0)}
    applyPlatformCarry(){const p=this.player;if(!p||!p.standingOnId)return;const q=this.data.platforms.find(z=>z.id===p.standingOnId&&z.hp!==0);if(!q){p.standingOnId=null;return}if(q.type!=='moving'&&q.type!=='elevator')return;const dx=q.deltaX||0,dy=q.deltaY||0;if(!dx&&!dy)return;p.x+=dx;p.y+=dy;p.x=clamp(p.x,this.data.minX||0,this.data.width-p.w);}
    updateWaterState(){const p=this.player,cx=p.x+p.w/2,cy=p.y+p.h/2;p.swim=this.data.waters.some(w=>cx>w.x&&cx<w.x+w.w&&cy>w.y&&cy<w.y+w.h)}
