        }
        if(q.type==='destructible'&&!q.material)q.material=palette[(i+1)%palette.length];
        if(q.type==='block_glass')q.material=q.material==='crystal'?'crystal':'glass';
        if(q.type==='block_iron')q.material=q.material==='metal'?'metal':'iron';
        if(q.type==='block_brick')q.material='brick';
        if(q.type==='block_stone')q.material='stone';
