      if(build&&!this.buildHeld&&this.buildCd<=0){this.placeBuildBlock(up,down);this.buildCd=.18}this.buildHeld=!!build;
      if(removeBuild&&!this.removeBuildHeld){this.removeBuildBlock();this.buildCd=.12}this.removeBuildHeld=!!removeBuild;
      if(editBuild&&!this.editBuildHeld){this.editBuildBlock(left,right,up,down);this.buildCd=.12}this.editBuildHeld=!!editBuild;
