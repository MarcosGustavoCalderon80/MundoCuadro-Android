      if(level>=8&&level%4===0){const sx=Math.floor(d.width*.72);d.platforms.push({id:uid('ruin'),type:'destructible',x:sx,y:GROUND-110,w:150,h:110,baseX:sx,baseY:GROUND-110,hp:3,material:'stone'},{id:uid('ruin'),type:'destructible',x:sx+150,y:GROUND-200,w:130,h:200,baseX:sx+150,baseY:GROUND-200,hp:3,material:'stone'});d.decor.push({type:'decor_banner',x:sx+215,y:GROUND-235,color:'#7d66ff'})}
