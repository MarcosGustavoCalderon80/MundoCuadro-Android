      this.ensureObjectiveIntegrity(d);return d;
    }
    buildHandcraftedWorldOne(level){
      const d=this.blankData(),design=this.levelDesign(level),r=rng(14000+level*701);d.handcrafted=true;d.isCustom=false;d.width=4300;d.spawn={x:120,y:GROUND-140};d.platforms=[];d.coins=[];d.cubes=[];d.enemies=[];d.springs=[];d.waters=[];d.lavas=[];d.hazards=[];d.doors=[];d.switches=[];d.keys=[];d.checkpoints=[];d.npcs=[];d.decor=[];d.chests=[];d.interiorDoors=[];d.timers=[];d.logicGates=[];d.signalLamps=[];d.integrity={repairs:[]};
