      const base=HERO[MC.state.data.avatar.heroBase]||HERO.explorer,gear=MC.state.gearBonuses?MC.state.gearBonuses():{};this.gearBonus=gear;this.hero={...base,hp:base.hp+(gear.hp||0),speed:base.speed+(gear.speed||0),jump:base.jump+(gear.jump||0),damage:base.damage+(gear.damage||0),cadence:Math.max(.11,base.cadence+(gear.cadence||0))};
      const diff=MC.state.data.settings.difficulty||'normal',hpBonus=diff==='casual'?1:diff==='challenge'?-1:0,maxHp=Math.max(3,this.hero.hp+hpBonus);
      this.player={x:this.data.spawn.x,y:this.data.spawn.y,w:58,h:96,standH:96,crouchH:62,vx:0,vy:0,onGround:false,standingOnId:null,dir:1,hp:maxHp,maxHp,inv:0,dash:0,shield:0,swim:false,doubleJump:this.airJumpCapacity(),crouching:false,groundPound:false,poundReady:true};this.magnetTime=Math.max(this.magnetTime||0,gear.magnet||0);
      this.camera=clamp(this.player.x-W*.36,Math.min(0,this.data.minX||0),Math.max(0,this.data.width-W));this.cameraY=this.data.isCustom?(this.player.y-H*.55):clamp(this.player.y-H*.55,this.data.minY??-200,Math.max(this.data.minY??-200,(this.data.maxY??(H+300))-H));
      this.preloadBackground();this.updateHUD();this.last=performance.now();requestAnimationFrame(t=>this.loop(t));
    }
    preloadBackground(){const key=this.theme.bg;if(this.bgCache[key])return;const img=new Image();img.src=`assets/backgrounds/background${key}.jpg`;this.bgCache[key]=img}
    gridLike(v,g=40){return Math.round(v/g)*g}
    blankData(){return{width:5200,height:1200,minY:-260,maxY:GROUND+360,spawn:{x:120,y:GROUND-130},platforms:[],coins:[],cubes:[],enemies:[],springs:[],waters:[],lavas:[],hazards:[],doors:[],switches:[],keys:[],checkpoints:[],npcs:[],decor:[],chests:[],interiorDoors:[],timers:[],logicGates:[],signalLamps:[],goal:{x:4800,y:GROUND-160,w:90,h:160},objective:{type:'collect',target:3,label:'Recolectá 3 cubos y llegá al portal'},sideQuest:null,design:null,integrity:{repairs:[]}}}
    buildLevel(level,custom){
      if(custom)return this.buildCustom(custom);
      if(level>=1&&level<=5)return this.buildHandcraftedWorldOne(level);
