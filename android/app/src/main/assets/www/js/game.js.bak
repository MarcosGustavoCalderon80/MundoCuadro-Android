      const jump=this.keys.Space||this.keys.KeyW||this.keys.ArrowUp||this.touch.jump,attack=this.keys.KeyJ||this.keys.KeyX||this.touch.attack,dash=this.keys.ShiftLeft||this.keys.ShiftRight||this.keys.KeyK||this.touch.dash,ability=this.keys.KeyQ||this.touch.ability,build=this.keys.KeyB||this.touch.build,cycleBuild=this.keys.KeyV||this.touch.cyclebuild,removeBuild=this.keys.KeyR||this.touch.removebuild,editBuild=this.keys.KeyC||this.touch.editbuild,mapTouch=this.touch.map;
