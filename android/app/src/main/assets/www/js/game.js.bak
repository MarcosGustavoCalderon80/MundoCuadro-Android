    canPlaceBuildBox(box,ignoreId=null){if(!box)return false;if(box.x<(this.data.minX||0)-120||box.x+box.w>this.data.width+280||box.y<-1400||box.y+box.h>2200)return false;const playerBox={x:this.player.x-10,y:this.player.y-10,w:this.player.w+20,h:this.player.h+20};if(hit(box,playerBox))return false;const solids=this.activePlatforms().concat((this.data.doors||[]).filter(d=>!d.open));return !solids.some(q=>q.id!==ignoreId&&q.hp!==0&&hit(box,{x:q.x,y:q.y,w:q.w,h:q.h}))}
