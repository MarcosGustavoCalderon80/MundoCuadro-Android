      anchors.forEach((p,idx)=>{
        const upperY=Math.max((d.minY??-260)+40,p.y-(160+idx*30));
        const lowerY=Math.min((d.maxY??(GROUND+360))-140,p.y+(130+idx*35));
        const upperX=Math.min(d.width-280,p.x+Math.max(50,Math.min(p.w-160,70+idx*30)));
        const lowerX=Math.min(d.width-340,p.x+Math.max(25,Math.min(p.w-220,40+idx*20)));
        add(`philo_up_${level}_${idx}`,upperX,upperY,220+idx*40,idx%2?32:34,idx%2?'moving':'semisolid',palette[(idx+1)%palette.length],idx%2?{axis:idx%3?'x':'y',range:90+idx*30,speed:.7+idx*.15}:{})
        if(idx<2)add(`philo_low_${level}_${idx}`,lowerX,lowerY,280+idx*70,95,idx%2?'crumble':'platform',palette[(idx+2)%palette.length],{});
        addCoins(upperX+25,upperY-36,3+idx,48);
      });
      const stairBase=anchors[1]||spots[2];
      if(stairBase){
        const dir=((level%2)===0?1:-1),size=80,startX=stairBase.x+Math.max(0,Math.min(stairBase.w-160,80)),startY=stairBase.y-80;
        for(let i=0;i<3;i++)add(`philo_stair_${level}_${i}`,startX+dir*(i*size),startY-(i*size),size,size,MATERIAL_BLOCK_TYPE[palette[(i+1)%palette.length]]||'block_brick',palette[(i+1)%palette.length],{hp:[ 'block_iron','block_obsidian' ].includes(MATERIAL_BLOCK_TYPE[palette[(i+1)%palette.length]]||'block_brick')?999:(MATERIAL_BLOCK_TYPE[palette[(i+1)%palette.length]]==='block_stone'?5:MATERIAL_BLOCK_TYPE[palette[(i+1)%palette.length]]==='block_wood'?2:MATERIAL_BLOCK_TYPE[palette[(i+1)%palette.length]]==='block_glass'?1:3),indestructible:['iron','metal','obsidian'].includes(palette[(i+1)%palette.length])});
      }
