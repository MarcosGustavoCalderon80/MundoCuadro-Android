      if(level>=7&&level%6===0){d.switches.push({x:Math.floor(d.width*.36),y:GROUND-25,w:50,h:25,link:'B',active:false});d.doors.push({x:Math.floor(d.width*.58),y:GROUND-150,w:72,h:150,link:'B',open:false});}
      if(level%3===0&&!boss)d.objective={type:'defeat',target:Math.min(8,Math.max(3,d.enemies.length)),label:`Derrotá ${Math.min(8,Math.max(3,d.enemies.length))} enemigos`};
      if(this.world===7){
