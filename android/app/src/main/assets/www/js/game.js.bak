    drawPlatformMaterialTexture(c,q,x,y){
      const raw=q.material||'grass',mat=raw==='metal'?'iron':raw;c.save();c.beginPath();c.rect(x,y,q.w,q.h);c.clip();c.globalAlpha=.36;
      if(mat==='brick'){c.strokeStyle='#4f231f';c.lineWidth=2;for(let yy=y+28,row=0;yy<y+q.h;yy+=28,row++){c.beginPath();c.moveTo(x,yy);c.lineTo(x+q.w,yy);c.stroke();for(let xx=x+(row%2?30:0);xx<x+q.w;xx+=60){c.beginPath();c.moveTo(xx,yy-28);c.lineTo(xx,yy);c.stroke()}}}
      else if(mat==='stone'){c.strokeStyle='#344451';c.lineWidth=2;for(let xx=x+28;xx<x+q.w;xx+=62){c.beginPath();c.moveTo(xx,y+18);c.lineTo(xx-12,y+q.h*.5);c.lineTo(xx+10,y+q.h-8);c.stroke()}}
      else if(mat==='wood'){c.strokeStyle='#4c301d';c.lineWidth=3;for(let yy=y+24;yy<y+q.h;yy+=26){c.beginPath();c.moveTo(x+4,yy);c.quadraticCurveTo(x+q.w*.5,yy-8,x+q.w-4,yy+2);c.stroke()}}
      else if(mat==='iron'){c.strokeStyle='#c2d8e4';c.fillStyle='#dbe8ef';c.lineWidth=2;for(let xx=x+48;xx<x+q.w;xx+=82){c.beginPath();c.moveTo(xx,y);c.lineTo(xx,y+q.h);c.stroke()}for(let xx=x+18;xx<x+q.w;xx+=70)for(let yy=y+28;yy<y+q.h;yy+=48){c.beginPath();c.arc(xx,yy,3,0,7);c.fill()}}
      else if(mat==='glass'||mat==='crystal'){c.fillStyle='rgba(255,255,255,.34)';for(let xx=x-20;xx<x+q.w;xx+=90){c.beginPath();c.moveTo(xx,y+q.h);c.lineTo(xx+44,y);c.lineTo(xx+59,y);c.lineTo(xx+15,y+q.h);c.fill()}}
      else if(mat==='obsidian'){c.strokeStyle='#8d6ad1';c.lineWidth=3;for(let xx=x+12;xx<x+q.w;xx+=54){c.beginPath();c.moveTo(xx,y+q.h);c.lineTo(xx+22,y);c.stroke()}}
      else if(mat==='grass'){c.strokeStyle='#b2ef78';c.lineWidth=2;for(let xx=x+10;xx<x+q.w;xx+=18){c.beginPath();c.moveTo(xx,y+14);c.lineTo(xx-5,y+4);c.moveTo(xx,y+14);c.lineTo(xx+5,y+3);c.stroke()}}
