    nearestEditableBuildBlock(maxDist=190){const p=this.player,px=p.x+p.w/2,py=p.y+p.h/2;let best=null,bd=maxDist;for(const q of this.data.platforms){if(!q.placedByPlayer||q.hp===0)continue;const d=Math.hypot((q.x+q.w/2)-px,(q.y+q.h/2)-py);if(d<bd){bd=d;best=q}}return best}
    removeBuildBlock(){const q=this.nearestEditableBuildBlock();if(!q){this.flash('Acercate a un bloque construido para retirarlo',900);return false}q.hp=0;MC.state.addMaterial(this.materialInventoryKey(q.material),1);this.burst(q.x+q.w/2,q.y+q.h/2,'#9eeeff',10);this.flash(`Recuperaste 1 ${this.materialLabel(q.material)}`,950);this.updateHUD();return true}
    editBuildBlock(left=false,right=false,up=false,down=false){const q=this.nearestEditableBuildBlock(220);if(!q){this.flash('Acercate a un bloque construido para editarlo',900);return false}const step=80,dx=left?-step:right?step:0,dy=up?-step:down?step:0;if(dx||dy){const box={x:this.gridLike(q.x+dx,40),y:this.gridLike(q.y+dy,40),w:q.w,h:q.h};if(!this.canPlaceBuildBox(box,q.id)){this.flash('Ese lugar está ocupado',800);return false}q.x=q.baseX=box.x;q.y=q.baseY=box.y;this.computeWorldBounds(this.data);this.flash('Bloque movido',650);return true}const mats=this.buildMaterials||this.buildMaterialOptions(this.world),newMat=mats[this.buildMaterialIndex%mats.length]||'brick',oldMat=q.material||'brick';if(newMat===oldMat){this.flash('Usá C + dirección para moverlo, o V para elegir otro material',1100);return false}if((MC.state.data.inventory.materials?.[this.materialInventoryKey(newMat)]||0)<=0){this.flash(`${this.materialLabel(newMat)} agotado`,850);return false}if(!MC.state.consumeMaterial(this.materialInventoryKey(newMat),1))return false;MC.state.addMaterial(this.materialInventoryKey(oldMat),1);q.material=newMat;q.type=MATERIAL_BLOCK_TYPE[newMat]||'block_brick';q.hp={block_brick:3,block_stone:5,block_wood:2,block_glass:1,block_iron:999,block_obsidian:999}[q.type]??3;q.maxHp=q.hp;q.indestructible=q.hp===999;this.flash(`Bloque cambiado a ${this.materialLabel(newMat)}`,900);this.updateHUD();return true}
    grantMaterialFromBlock(q,n=1){if(!q||q._materialGranted)return;const mat=this.materialInventoryKey(q.material||((q.type||'').replace('block_',''))||'stone');q._materialGranted=true;MC.state.addMaterial(mat,n);this.flash(`+${n} ${this.materialLabel(mat)} recuperado`,800);this.updateHUD()}
    firePlayer(aim=0){const p=this.player,dir=p.dir;this.shots.push({x:p.x+p.w/2+dir*30,y:p.y+(p.crouching?p.h*.45:35),vx:aim?dir*400:dir*850,vy:aim*620,r:9,life:1.5,damage:this.hero.damage,pierce:MC.state.data.avatar.heroBase==='void'?2:1})}
    useAbility(){const id=MC.state.data.avatar.heroBase||'explorer',p=this.player;this.abilityCd=id==='runner'?2.2:4.5;if(id==='runner'){p.vx=p.dir*1250;p.dash=.35}else if(id==='guardian'){p.shield=4}else if(id==='aqua'){p.vx=p.dir*900;p.vy=-280}else if(id==='forge'){this.tempPlatforms.push({x:p.x+p.dir*100,y:p.y+p.h+25,w:180,h:28,life:8})}else if(id==='void'){for(const v of [-.35,0,.35])this.shots.push({x:p.x+p.w/2,y:p.y+35,vx:p.dir*820,vy:v*600,r:12,life:1.8,damage:2,pierce:3})}else{for(const e of this.data.enemies){if(!e.dead&&Math.abs((e.x+e.w/2)-(p.x+p.w/2))<260){e.hp-=2;if(e.hp<=0)e.dead=true}}}}
    updateShots(dt){
      for(const s of this.shots){s.x+=s.vx*dt;s.y+=s.vy*dt;s.life-=dt;for(const e of this.data.enemies){if(e.dead)continue;if(hit({x:s.x-s.r,y:s.y-s.r,w:s.r*2,h:s.r*2},e)){e.hp-=s.damage;s.pierce--;if(e.hp<=0){e.dead=true;this.burst(e.x+e.w/2,e.y+e.h/2,'#ff7c72',14)}if(s.pierce<=0)s.life=0;break}}for(const q of this.data.platforms){const breakable=q.type==='destructible'||['block_brick','block_stone','block_wood','block_glass'].includes(q.type);if(breakable&&!q.indestructible&&q.hp>0&&hit({x:s.x-s.r,y:s.y-s.r,w:s.r*2,h:s.r*2},q)){const before=q.hp;q.hp-=s.damage;if(q.hp<=0&&before>0){this.brokenBlocks++;this.grantMaterialFromBlock(q,1);this.burst(q.x+q.w/2,q.y+q.h/2,'#ffd06a',12)}s.life=0;break}}}
      this.shots=this.shots.filter(s=>s.life>0&&s.x>(this.data.minX||0)-200&&s.x<this.data.width+200&&s.y>(this.data.minY||-200)-200&&s.y<(this.data.maxY||H+400)+200);
      for(const s of this.enemyShots){s.x+=s.vx*dt;s.y+=s.vy*dt;s.life-=dt;if(hit({x:s.x-8,y:s.y-8,w:16,h:16},this.player)){s.life=0;this.hurt(false)}}this.enemyShots=this.enemyShots.filter(s=>s.life>0)
    }
    groundPoundImpact(platform){
      const p=this.player,ix=p.x+p.w/2,iy=p.y+p.h;this.burst(ix,iy,'#ffd45d',20);this.effects.push({x:ix,y:iy,vx:0,vy:0,life:.45,max:.45,color:'#fff1a8',ring:true,r:16});
      for(const e of this.data.enemies){if(e.dead)continue;const ex=e.x+e.w/2,ey=e.y+e.h/2;if(Math.abs(ex-ix)<150&&Math.abs(ey-iy)<125){e.hp-=3;if(e.hp<=0){e.dead=true;this.burst(ex,ey,'#ff7c72',16)}}}
      if(platform&&!platform.indestructible&&['destructible','block_brick','block_stone','block_wood','block_glass'].includes(platform.type)){const orig=this.data.platforms.find(q=>q.id===platform.id)||platform,before=orig.hp??3;orig.hp=before-(3+(this.gearBonus?.breakPower||0));if(orig.hp<=0){orig.hp=0;if(before>0){this.brokenBlocks++;this.grantMaterialFromBlock(orig,1)}this.burst(orig.x+orig.w/2,orig.y+orig.h/2,'#ffd06a',18)}}
      p.groundPound=false;
    }
    burst(x,y,color='#69efff',count=8){for(let i=0;i<count;i++){const a=Math.random()*Math.PI*2,sp=80+Math.random()*220;this.effects.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-80,life:.45+Math.random()*.45,max:.9,r:2+Math.random()*5,color})}}
    updateEffects(dt){for(const e of this.effects){e.x+=e.vx*dt;e.y+=e.vy*dt;e.vy+=520*dt;e.life-=dt}this.effects=this.effects.filter(e=>e.life>0)}
    drawEffects(c,cam){for(const e of this.effects){c.save();c.globalAlpha=Math.max(0,e.life/e.max);c.shadowColor=e.color;c.shadowBlur=10;c.beginPath();if(e.ring){const k=1-e.life/e.max;c.strokeStyle=e.color;c.lineWidth=6*(1-k)+2;c.arc(e.x-cam,this.sy(e.y),18+k*105,0,7);c.stroke()}else{c.fillStyle=e.color;c.arc(e.x-cam,this.sy(e.y),e.r||4,0,7);c.fill()}c.restore()}}
        collect(){const p=this.player,mag=this.magnetTime>0?190:0;for(const c of this.data.coins){const dist=Math.hypot(p.x+p.w/2-c.x,p.y+p.h/2-c.y);if(!c.got&&mag&&dist<mag){c.x+=(p.x+p.w/2-c.x)*.12;c.y+=(p.y+p.h/2-c.y)*.12}if(!c.got&&dist<60){c.got=true;this.burst(c.x,c.y,'#ffd34d',6);this.scoreCoins++;this.lifeCoinCounter++;const lifeGoal=MC.state.data.settings.extraLifeCoins||100;if(this.lifeCoinCounter>=lifeGoal){this.lifeCoinCounter-=lifeGoal;MC.state.data.profile.lifeCoinProgress=this.lifeCoinCounter;MC.state.addLife(1);this.flash('¡VIDA EXTRA!')}else{MC.state.data.profile.lifeCoinProgress=this.lifeCoinCounter;MC.state.save()}this.updateHUD()}}for(const c of this.data.cubes){const dist=Math.hypot(p.x+p.w/2-c.x,p.y+p.h/2-c.y);if(!c.got&&mag&&dist<mag){c.x+=(p.x+p.w/2-c.x)*.09;c.y+=(p.y+p.h/2-c.y)*.09}if(!c.got&&dist<70){c.got=true;this.burst(c.x,c.y,this.theme.accent,10);if(c.objective!==false)this.collectedCubes++;this.flash(c.objective===false?'Cubo extra encontrado':`Cubo ${this.collectedCubes}/${this.data.objective.type==='collect'?this.data.objective.target:this.data.cubes.filter(x=>x.objective!==false).length}`);this.updateHUD()}}for(const k of this.data.keys){if(k.got)continue;const kw=k.w||48,kh=k.h||48,kcx=k.x+kw/2,kcy=k.y+kh/2,pcx=p.x+p.w/2,pcy=p.y+p.h/2,dist=Math.hypot(pcx-kcx,pcy-kcy),near=Math.abs(pcx-kcx)<92&&Math.abs(pcy-kcy)<118,box={x:k.x-18,y:k.y-18,w:kw+36,h:kh+36};if(hit(p,box)||near||dist<88){k.got=true;this.keysOwned.add(k.link||'A');for(const d of this.data.doors)if((d.link||'A')===(k.link||'A'))d.open=true;this.burst(kcx,kcy,'#ffd34d',12);this.flash('🔑 Llave obtenida · puerta vinculada abierta',1900);this.updateHUD()}}}
    interactions(){const p=this.player;for(const s of this.data.switches){if(s.type==='pressure')continue;if(!s.active&&hit(p,s)){s.active=true;this.switches.add(s.link||'A');for(const d of this.data.doors)if((d.link||'A')===(s.link||'A'))d.open=true;this.flash('Interruptor activado')}}for(const cp of this.data.checkpoints){if(!cp.active&&hit(p,cp)){this.data.checkpoints.forEach(x=>x.active=false);cp.active=true;this.checkpoint={x:cp.x-30,y:cp.y-110};this.flash('✓ Punto de control')}}const interact=this.keys.KeyE||this.touch.interact;if(interact&&!this.interactHeld){const n=this.data.npcs.find(n=>n.near);if(n){this.talkTo(n);this.interactHeld=true;return}const chest=this.data.chests.find(ch=>!ch.opened&&Math.abs((ch.x+ch.w/2)-(p.x+p.w/2))<110&&Math.abs(ch.y-p.y)<120);if(chest){chest.opened=true;const item=chest.item||['potion','shield','magnet','bomb'][Math.floor(Math.random()*4)];let label=item;if(String(item).startsWith('gear:')){const gid=String(item).slice(5),g=MC.GEAR_CATALOG?.[gid];MC.state.addGear(gid);label=g?.name||gid}else MC.state.addItem(item,1);if(chest.secret){this.runSecrets++;MC.state.markSecret(this.level,chest.id)}this.flash(`${chest.secret?'✦ Secreto encontrado · ':''}${String(item).startsWith('gear:')?'Equipo obtenido':'Cofre'}: ${chest.lootName||label}`,2500);this.renderInventory();this.interactHeld=true;return}const door=this.data.interiorDoors.find(d=>Math.abs((d.x+d.w/2)-(p.x+p.w/2))<90&&Math.abs(d.y-p.y)<130);if(door){const pair=this.data.interiorDoors.find(d=>d!==door&&d.link===door.link);if(pair){p.x=pair.x+(pair.x>door.x?70:-70);p.y=pair.y;this.camera=p.x-W*.4;this.cameraY=p.y-H*.55;this.flash(pair.label==='SALIR'?'Entraste al interior':'Volviste al exterior',1100)}this.interactHeld=true;return}}this.interactHeld=!!interact}
    npcLogic(dt){const p=this.player;for(const n of this.data.npcs){n.phase=(n.phase||0)+dt;if(n.baseY==null){n.baseY=n.y;n.baseX=n.x;n.patrolRange=28}if(!n.biome)n.biome=this.npcBiome(n);if(n.talkCd>0)n.talkCd-=dt;const dx=p.x-(n.x+n.w/2),support=this.data.platforms.find(q=>q.id===n.supportId&&q.hp!==0),near=Math.abs(dx)<150&&Math.abs((p.y+p.h/2)-(n.y+n.h/2))<145;n.near=near;const speedByPersonality={brave:.65,curious:.5,cheerful:.58,serious:.28,inventive:.36,helpful:.42},pace=speedByPersonality[n.personality]||.4,canWalk=!near&&n.kind!=='merchant'&&n.kind!=='inventor';if(canWalk){const ox=Math.sin(n.phase*pace+(n.variant||0))*n.patrolRange;n.x=n.baseX+ox;if(support)n.x=clamp(n.x,support.x+10,Math.max(support.x+10,support.x+support.w-n.w-10));n.dir=Math.cos(n.phase*pace+(n.variant||0))>=0?1:-1}else if(Math.abs(dx)<500)n.dir=dx>=0?1:-1;n.y=n.baseY;if(near)n.gesture='wave';else{const cycle=Math.floor(n.phase/2.7+(n.variant||0))%6;n.gesture=cycle===0?'look':cycle===1&&n.personality==='cheerful'?'wave':cycle===2&&n.personality==='inventive'?'tool':cycle===3&&n.personality==='brave'?'pose':'idle'}}}
    npcBiome(n){const f=String(this.data.design?.feature||'');if(this.world===8||/citadel|wall|castle|core/.test(f))return'knight';if(/ice|glacier/.test(f))return'polar';if(/lava|volcano|magma|elemental/.test(f))return'volcanic';if(/ocean|marine|swamp/.test(f))return'coastal';if(this.world===2||/mine|quarry/.test(f))return'miner';if(this.world===4||/sky|storm|orbit/.test(f))return'sky';if(this.world===6)return'toy';if(this.world===7)return'void';return'meadow'}
    enemyLogic(dt){const p=this.player,diff=MC.state.data.settings.difficulty||'normal',rate=diff==='casual'?1.25:diff==='challenge'?.78:1;for(const e of this.data.enemies){if(e.dead)continue;e.phase+=dt;e.shotCd-=dt;e.hitFlash=Math.max(0,(e.hitFlash||0)-dt);e.aiTimer=Math.max(0,(e.aiTimer||0)-dt);e.aiCooldown=Math.max(0,(e.aiCooldown||0)-dt);const dx=p.x-e.x,dy=p.y-e.y,dist=Math.abs(dx);
      if(e.type==='blob'){e.x=e.baseX+Math.sin(e.phase*1.45)*75;e.state='patrol'}
      else if(e.type==='hopper'){e.x=e.baseX+Math.sin(e.phase*.9)*52;e.y=e.baseY-Math.abs(Math.sin(e.phase*2.2))*92;e.state='jump'}
      else if(e.type==='charger'){if(!e.aiState)e.aiState='patrol';if(e.aiState==='patrol'){e.x=e.baseX+Math.sin(e.phase*.85)*90;e.dir=Math.cos(e.phase*.85)>=0?1:-1;e.state='patrol';if(dist<430&&Math.abs(dy)<170&&e.aiCooldown<=0){e.aiState='windup';e.aiTimer=.38;e.chargeDir=dx>=0?1:-1;e.dir=e.chargeDir;e.state='windup'}}else if(e.aiState==='windup'){e.dir=e.chargeDir||e.dir||1;e.state='windup';if(e.aiTimer<=0){e.aiState='charge';e.aiTimer=.72}}else if(e.aiState==='charge'){e.dir=e.chargeDir||1;e.x+=e.dir*330*dt;e.state='charge';if(e.aiTimer<=0||Math.abs(e.x-e.baseX)>360){e.aiState='recover';e.aiTimer=.72;e.aiCooldown=1.1}}else{const back=e.baseX-e.x,step=Math.sign(back)*Math.min(Math.abs(back),210*dt);e.x+=step;e.dir=back>=0?1:-1;e.state='recover';if(Math.abs(back)<12||e.aiTimer<=0){e.aiState='patrol';e.aiCooldown=Math.max(e.aiCooldown,.8)}}}
      else if(e.type==='drone'){e.x=e.baseX+Math.sin(e.phase)*95;e.y=e.baseY+Math.sin(e.phase*1.8)*36;e.state='fly'}
      else if(e.type==='bat'){if(!e.aiState)e.aiState='patrol';if(e.aiState==='patrol'){e.x=e.baseX+Math.sin(e.phase*1.25)*120;e.y=e.baseY+Math.cos(e.phase*2.1)*48;e.state='fly';if(dist<340&&Math.abs(dy)<260&&e.aiCooldown<=0){const m=Math.hypot(dx,dy)||1;e.aiVX=dx/m*300;e.aiVY=dy/m*300;e.aiState='swoop';e.aiTimer=.72;e.aiCooldown=1.4}}else if(e.aiState==='swoop'){e.x+=e.aiVX*dt;e.y+=e.aiVY*dt;e.dir=e.aiVX>=0?1:-1;e.state='swoop';if(e.aiTimer<=0){e.aiState='return';e.aiTimer=.9}}else{const tx=e.baseX+Math.sin(e.phase*1.25)*120,ty=e.baseY+Math.cos(e.phase*2.1)*48,k=Math.min(1,dt*4.6);e.x+=(tx-e.x)*k;e.y+=(ty-e.y)*k;e.dir=tx>=e.x?1:-1;e.state='return';if(e.aiTimer<=0&&Math.hypot(tx-e.x,ty-e.y)<28)e.aiState='patrol'}}
      else if(e.type==='guard'){e.dir=dx>0?1:-1;if(dist<560&&e.shotCd<=0){const dy=(p.y-e.y),m=Math.hypot(dx,dy)||1;this.enemyShots.push({x:e.x+30,y:e.y+24,vx:dx/m*440,vy:dy/m*440,life:2.5});e.shotCd=1.8*rate;e.state='attack'}else e.state='aim'}
      else if(e.type==='turret'){e.dir=dx>0?1:-1;if(dist<680&&e.shotCd<=0){const dy=(p.y-e.y),m=Math.hypot(dx,dy)||1;for(const spread of [-.12,.12])this.enemyShots.push({x:e.x+e.w/2,y:e.y+20,vx:dx/m*360,vy:dy/m*360+spread*260,life:3});e.shotCd=2.25*rate;e.state='attack'}}
      else if(e.type==='fish'){e.x=e.baseX+Math.sin(e.phase*1.45)*120;e.y=e.baseY+Math.sin(e.phase*2.2)*24}
      else if(e.type==='shark'){if(!e.aiState)e.aiState='patrol';if(e.aiState==='patrol'){e.x=e.baseX+Math.sin(e.phase*.8)*190;e.y=e.baseY+Math.sin(e.phase*1.5)*18;e.dir=Math.cos(e.phase*.8)>=0?1:-1;e.state='swim';if(dist<500&&Math.abs(dy)<240&&e.aiCooldown<=0){const m=Math.hypot(dx,dy)||1;e.aiVX=dx/m*285;e.aiVY=dy/m*190;e.aiState='lunge';e.aiTimer=.82;e.aiCooldown=1.5}}else if(e.aiState==='lunge'){e.x+=e.aiVX*dt;e.y+=e.aiVY*dt;e.dir=e.aiVX>=0?1:-1;e.state='lunge';if(e.aiTimer<=0||Math.abs(e.x-e.baseX)>420){e.aiState='return';e.aiTimer=1.0}}else{const tx=e.baseX+Math.sin(e.phase*.8)*190,ty=e.baseY+Math.sin(e.phase*1.5)*18,k=Math.min(1,dt*3.4);e.x+=(tx-e.x)*k;e.y+=(ty-e.y)*k;e.dir=tx>=e.x?1:-1;e.state='return';if(e.aiTimer<=0&&Math.hypot(tx-e.x,ty-e.y)<34)e.aiState='patrol'}}
      else if(e.type==='jellyfish'){e.y=e.baseY+Math.sin(e.phase*1.4)*54;e.x=e.baseX+Math.sin(e.phase*.55)*42}
      else if(e.type==='eel'){e.dir=Math.sin(e.phase*.8)>0?1:-1;e.x=e.baseX+Math.sin(e.phase*.9)*180;e.y=e.baseY+Math.sin(e.phase*2.7)*32}
      else if(e.type==='seahorse'){e.x=e.baseX+Math.sin(e.phase*.7)*36;e.y=e.baseY+Math.sin(e.phase*1.7)*42}
      else if(e.type==='crab'){e.dir=Math.sin(e.phase*.75)>0?1:-1;e.x=e.baseX+Math.sin(e.phase*.75)*105;e.y=e.baseY+Math.abs(Math.sin(e.phase*2.5))*4}
      else if(e.type==='boss'){const ratio=e.hp/e.maxHp,phase=ratio>.66?1:ratio>.33?2:3,style=e.archetype||'meadow',speed=phase===1?.72:phase===2?1.05:1.42;e.state='phase'+phase;e.x=e.baseX+Math.sin(e.phase*speed)*(phase===1?210:phase===2?275:330);e.y=e.baseY+Math.sin(e.phase*(1.15+phase*.45))*(phase===1?8:phase===2?30:52);if(style==='void'&&phase===3&&Math.sin(e.phase*.9)>.985)e.x=clamp(p.x+(Math.random()>.5?360:-360),e.baseX-420,e.baseX+420);if(style==='sky'&&phase>=2)e.y=e.baseY-70+Math.sin(e.phase*2.6)*85;if(e.shotCd<=0){const dir=p.x<e.x?-1:1,baseSpeed=400+phase*70;if(style==='elemental'){const spreads=phase===1?[-.25,.25]:phase===2?[-.55,0,.55]:[-.75,-.38,0,.38,.75];for(const a of spreads)this.enemyShots.push({x:e.x+e.w/2,y:e.y+60,vx:dir*baseSpeed,vy:a*420,life:3,color:phase===3?'#8be8ff':'#ff7849'});if(phase===3)for(const vx of [-320,320])this.enemyShots.push({x:e.x+e.w/2,y:e.y+20,vx,vy:-520,life:3,color:'#ffd45c'})}
        else if(style==='toy'){for(let i=0;i<phase+1;i++){const off=(i-(phase/2))*110,sp=enemySpec(i%2?'hopper':'blob');this.data.enemies.push({id:uid('minion'),x:e.x+off,y:GROUND-sp.h,w:sp.w,h:sp.h,hp:sp.hp,maxHp:sp.hp,dead:false,type:i%2?'hopper':'blob',phase:i,baseX:e.x+off,baseY:GROUND-sp.h,dir:dir,shotCd:1,state:'idle',objective:false})}this.enemyShots.push({x:e.x+e.w/2,y:e.y+70,vx:dir*baseSpeed,vy:-180,life:3})}
        else if(style==='quarry'||style==='colossus'){for(const a of [-.55,0,.55])this.enemyShots.push({x:e.x+e.w/2,y:e.y+80,vx:dir*(baseSpeed-40),vy:a*330,life:3});if(phase>=2)this.effects.push({x:p.x+Math.random()*420-210,y:p.y-260,vx:0,vy:0,life:1,max:1,color:'#d4b17a',ring:true,r:10})}
        else if(style==='supreme'){const spreads=[-.75,-.38,0,.38,.75].slice(phase===1?1:0,phase===1?4:5);for(const a of spreads)this.enemyShots.push({x:e.x+e.w/2,y:e.y+60,vx:dir*(baseSpeed+40),vy:a*400,life:3});if(phase===3)for(const v of [-1,1])this.enemyShots.push({x:e.x+e.w/2,y:e.y+10,vx:v*280,vy:520,life:2.5})}
        else{const spreads=phase===1?[-.32,0,.32]:phase===2?[-.58,-.2,.2,.58]:[-.72,-.36,0,.36,.72];for(const a of spreads)this.enemyShots.push({x:e.x+e.w/2,y:e.y+70,vx:dir*baseSpeed,vy:a*360,life:3});if(phase===3)this.enemyShots.push({x:e.x+e.w/2,y:e.y+15,vx:dir*260,vy:540,life:2.6})}e.shotCd=(phase===1?1.22:phase===2?.82:.55)*rate}}
      if(hit(p,e)){if(p.groundPound&&p.vy>250&&p.y+p.h<=e.y+e.h*.86){e.hp-=3;p.vy=-440;p.groundPound=false;this.burst(e.x+e.w/2,e.y+e.h/2,'#ffd45d',14);if(e.hp<=0)e.dead=true}else if(p.inv<=0){const away=(e.x+e.w/2)<(p.x+p.w/2)?-1:1;this.hurt(false);if(!['guard','turret','boss'].includes(e.type)){e.x+=away*26;e.aiCooldown=Math.max(e.aiCooldown||0,.75);if(['charger','bat','shark'].includes(e.type)){e.aiState='recover';e.aiTimer=Math.max(e.aiTimer||0,.55)}}}}}
    }
    hazards(){const p=this.player;for(const h of this.data.hazards)if(hit(p,h))this.hurt(false);for(const l of this.data.lavas)if(hit(p,l))this.hurt(false,true)}
    hurt(fall=false,severe=false){const p=this.player;if(p.inv>0||p.shield>0)return;const diff=MC.state.data.settings.difficulty||'normal',damage=diff==='casual'?1:diff==='challenge'?(severe?3:2):(severe?2:1);p.hp-=damage;this.damageTaken++;p.inv=diff==='casual'?1.7:1.25;if(!fall){p.vx=-p.dir*430;p.vy=-430}if(p.hp<=0)this.loseLife();this.updateHUD()}
    fallDeath(){this.hurt(true,true);if(this.player.hp>0)this.respawn()}
    loseLife(){MC.state.spendLife();const set=MC.state.data.settings;if((MC.state.data.profile.lives||0)<=0){if((MC.state.data.profile.continues||0)>0){MC.state.data.profile.continues--;MC.state.data.profile.lives=set.initialLives||3;MC.state.save();this.flash(`CONTINUE · ${MC.state.data.profile.lives} vidas restauradas`,2300)}else{MC.state.data.profile.lives=set.initialLives||3;MC.state.data.profile.continues=set.initialContinues||0;this.checkpoint={x:this.data.spawn.x,y:this.data.spawn.y};MC.state.save();this.flash('GAME OVER · reiniciando el nivel',2300)}}this.player.hp=this.player.maxHp;this.respawn()}
    respawn(){const p=this.player,target=(MC.state.data.settings.respawnMode==='level')?this.data.spawn:this.checkpoint;p.x=target.x;p.y=target.y;p.vx=0;p.vy=0;p.inv=1.5;p.h=p.standH;p.crouching=false;p.groundPound=false;p.standingOnId=null;p.doubleJump=this.airJumpCapacity()}
    objectiveDone(){const o=this.data.objective;if(o.type==='collect')return this.collectedCubes>=o.target;if(o.type==='defeat')return this.data.enemies.filter(e=>e.dead&&e.type!=='boss'&&e.objective!==false).length>=o.target;if(o.type==='boss')return this.data.enemies.filter(e=>e.type==='boss').every(e=>e.dead);if(o.type==='key')return this.keysOwned.size>0;return true}
    objectiveProgress(){const o=this.data.objective;if(o.type==='collect')return [this.collectedCubes,o.target];if(o.type==='defeat')return [this.data.enemies.filter(e=>e.dead&&e.type!=='boss'&&e.objective!==false).length,o.target];if(o.type==='boss')return [this.data.enemies.filter(e=>e.type==='boss'&&e.dead).length,1];if(o.type==='key')return [this.keysOwned.size?1:0,1];return [1,1]}
    checkGoal(){const p=this.player,g=this.data.goal;if(hit(p,g)&&!this.complete){if(this.objectiveDone()){this.complete=true;this.running=false;const stars=(this.damageTaken===0?1:0)+(this.scoreCoins>=Math.max(10,Math.floor(this.data.coins.length*.55))?1:0)+(this.time<150?1:0),firstClear=!MC.state.data.progress.completed.includes(this.level),reward=this.data.design?.completionReward;if(firstClear&&reward){if(reward.coins)MC.state.addCoins(reward.coins);if(reward.gear)MC.state.addGear(reward.gear)}if(this.custom)MC.state.addCoins(this.scoreCoins);else MC.state.completeLevel(this.level,stars,this.scoreCoins);if(firstClear&&reward?.gear)this.flash(`🏆 Equipo de mundo obtenido: ${MC.GEAR_CATALOG?.[reward.gear]?.name||reward.gear}`,2800);if(this.onComplete)this.onComplete({stars,coins:this.scoreCoins,time:this.time,level:this.level})}else{this.repairRuntimeObjective();const [a,b]=this.objectiveProgress(),t=this.objectiveTarget();this.flash(t?`Objetivo pendiente · ${a}/${b} · seguí el indicador de misión`:`Objetivo pendiente · reparando misión`,2600)}}}
    updateHUD(){const p=this.player;if(!p)return;const he=document.getElementById('hud-hearts');if(he)he.textContent='❤'.repeat(Math.max(0,p.hp))+'♡'.repeat(Math.max(0,p.maxHp-p.hp));const cc=document.getElementById('hud-coins');if(cc)cc.textContent=this.scoreCoins||0;const bm=document.getElementById('hud-build-material');if(bm){const m=(this.buildMaterials||['brick'])[this.buildMaterialIndex||0],n=MC.state.data.inventory.materials?.[this.materialInventoryKey(m)]||0;bm.textContent=`${this.materialLabel(m)} x${n}`}const lives=document.getElementById('hud-lives');if(lives)lives.textContent=MC.state.data.profile.lives||0;const cont=document.getElementById('hud-continues');if(cont)cont.textContent=MC.state.data.profile.continues||0;const ability=document.getElementById('hud-ability');if(ability)ability.textContent=`Q · ${this.hero.ability}${this.abilityCd>0?' '+this.abilityCd.toFixed(1)+'s':''}`;const [a,b]=this.objectiveProgress();const fill=document.getElementById('objective-fill');if(fill)fill.style.width=`${b?clamp(a/b*100,0,100):100}%`;const txt=document.getElementById('hud-objective');if(txt)txt.textContent=`${this.data.objective.label} · ${Math.min(a,b)}/${b}`;const side=document.getElementById('hud-sidequest');if(side){if(!this.activeQuest){side.textContent='';side.classList.add('hidden')}else{const q=this.activeQuest,sp=Math.min(q.target,q.progress??this.sideQuestProgress());side.classList.remove('hidden');side.textContent=q.status==='completed'?`★ ${q.title} · COMPLETADA`:`☆ ${q.title} · ${sp}/${q.target}${q.status==='inactive'?' · hablá con un NPC':''}`}}}
    flash(text,ms=1500){const el=document.getElementById('game-toast');if(!el)return;el.textContent=text;el.classList.add('show');clearTimeout(this.toastT);this.toastT=setTimeout(()=>el.classList.remove('show'),ms)}
    loop(t){if(!this.running&&!this.complete)return;if(this.complete){this.draw();return}const dt=Math.min(.034,(t-this.last)/1000||0);this.last=t;if(!this.paused){this.update(dt);this.updateHUD()}this.draw();requestAnimationFrame(x=>this.loop(x))}
    avatarImage(action='idle'){const key=action+JSON.stringify(MC.state.data.avatar);if(this.avatarCache.has(key))return this.avatarCache.get(key);const img=new Image();img.src='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(MC.avatar.svg(MC.state.data.avatar,{action}));this.avatarCache.set(key,img);return img}
    draw(){const c=this.ctx,p=this.player;c.clearRect(0,0,W,H);this.drawBackground(c,this.camera,this.cameraY);this.drawWorld(c,this.camera,this.cameraY);this.drawShots(c,this.camera,this.cameraY);this.drawEffects(c,this.camera);this.drawPlayer(c,p,this.camera,this.cameraY);this.drawPet(c,p,this.camera,this.cameraY);this.drawSummonedCompanion(c,p,this.camera,this.cameraY);this.drawCompanionSpeech(c,p,this.camera,this.cameraY);this.drawObjectiveGuide(c);this.drawMiniMap(c,this.showMap)}
    sy(y){return y-this.cameraY}
    drawBackground(c,cam,cy){const th=this.theme;c.fillStyle=th.sky;c.fillRect(0,0,W,H);const img=this.bgCache[th.bg];if(img&&img.complete){c.save();c.globalAlpha=.52;c.filter='saturate(1.35) contrast(1.07)';const ratio=Math.max(W/img.width,H/img.height);const iw=img.width*ratio,ih=img.height*ratio;const ox=-((cam*.06)%(Math.max(1,iw-W)));c.drawImage(img,ox,(H-ih)*.4-cy*.05,iw,ih);c.restore()}const g=c.createLinearGradient(0,0,0,H);g.addColorStop(0,'rgba(8,60,160,.02)');g.addColorStop(.7,'rgba(15,70,120,.12)');g.addColorStop(1,'rgba(0,12,30,.42)');c.fillStyle=g;c.fillRect(0,0,W,H);c.save();c.globalAlpha=.38;for(let i=0;i<8;i++){const x=((i*330-cam*.14)%2350+2350)%2350-120,y=150+(i%3)*92-cy*.08;c.fillStyle=th.ground;c.beginPath();c.roundRect(x,y,220,44,18);c.fill();c.fillStyle='rgba(0,0,0,.25)';c.beginPath();c.moveTo(x+20,y+42);c.lineTo(x+110,y+120);c.lineTo(x+200,y+42);c.fill();c.fillStyle=th.edge;c.fillRect(x,y,220,11)}c.restore()}
    drawWorld(c,cam,cy){const th=this.theme;
      for(const q of this.data.platforms){if(q.hp===0)continue;const x=q.x-cam,y=this.sy(q.y);if(x+q.w<0||x>W)continue;if(q.type==='destructible'||q.type.startsWith('block_')){this.drawBlockPlatform(c,q,x,y);continue;}const surf=this.platformSurfaceColors(q,th),top=surf.top,body=surf.body;c.fillStyle=body;c.beginPath();c.roundRect(x,y,q.w,q.h,10);c.fill();c.fillStyle=top;c.fillRect(x,y,q.w,Math.min(17,q.h));this.drawPlatformMaterialTexture(c,q,x,y);if(q.type==='moving'||q.type==='elevator'){c.strokeStyle=surf.edge||th.accent;c.lineWidth=4;c.strokeRect(x+8,y+8,q.w-16,q.h-16)}if(q.material&&['platform','moving','elevator','semisolid','crumble'].includes(q.type)){c.fillStyle='rgba(255,255,255,.08)';for(let xx=x+18;xx<x+q.w-14;xx+=42)c.fillRect(xx,y+Math.min(24,q.h*.35),Math.min(26,q.w*.18),4)}if(q.type==='conveyor'){c.fillStyle='#20283a';for(let xx=x+14;xx<x+q.w-14;xx+=34){c.beginPath();c.moveTo(xx,y+q.h*.55);c.lineTo(xx+14,y+q.h*.35);c.lineTo(xx+14,y+q.h*.75);c.fill()}}if(q.type==='bounce'){c.strokeStyle='#b9fbff';c.lineWidth=5;c.beginPath();c.moveTo(x+10,y+q.h-8);c.lineTo(x+32,y+8);c.lineTo(x+54,y+q.h-8);c.lineTo(x+76,y+8);c.stroke()}if(q.type==='crumble'){c.strokeStyle=surf.edge||'#5d4637';c.lineWidth=3;c.beginPath();c.moveTo(x+12,y+8);c.lineTo(x+q.w*.45,y+q.h-8);c.moveTo(x+q.w*.66,y+6);c.lineTo(x+q.w*.50,y+q.h-7);c.stroke()}}
      for(const w of this.data.waters){const x=w.x-cam,y=this.sy(w.y);c.fillStyle='rgba(45,177,236,.38)';c.fillRect(x,y,w.w,w.h);c.fillStyle='rgba(155,250,255,.9)';for(let xx=x;xx<x+w.w;xx+=38)c.fillRect(xx,y,22,5)}for(const l of this.data.lavas){const x=l.x-cam,y=this.sy(l.y);c.fillStyle='rgba(255,73,25,.68)';c.fillRect(x,y,l.w,l.h);c.fillStyle='#ffd44d';for(let xx=x;xx<x+l.w;xx+=42)c.fillRect(xx,y+Math.sin(this.time*5+xx*.03)*4,24,6)}
      for(const s of this.data.springs){const x=s.x-cam,y=this.sy(s.y);c.fillStyle='#29394e';c.fillRect(x,y,s.w,s.h);c.strokeStyle=th.accent;c.lineWidth=6;c.beginPath();c.moveTo(x+8,y+2);c.lineTo(x+20,y-22);c.lineTo(x+34,y+2);c.lineTo(x+46,y-22);c.stroke()}
      for(const h of this.data.hazards){const x=h.x-cam,y=this.sy(h.y);if(h.type==='fire'){c.save();c.fillStyle='#ff9e2d';c.shadowColor='#ff6128';c.shadowBlur=18;for(let i=0;i<3;i++){const bx=x+12+i*18;c.beginPath();c.moveTo(bx,y+h.h);c.quadraticCurveTo(bx-8,y+18+Math.sin(this.time*7+i)*6,bx+5,y);c.quadraticCurveTo(bx+20,y+22,bx+18,y+h.h);c.fill()}c.restore()}else if(h.type==='saw'){c.save();c.translate(x+h.w/2,y+h.h/2);c.rotate(this.time*4);c.fillStyle='#dfe8ef';for(let i=0;i<12;i++){c.rotate(Math.PI/6);c.fillRect(22,-5,18,10)}c.beginPath();c.arc(0,0,27,0,7);c.fill();c.fillStyle='#506274';c.beginPath();c.arc(0,0,9,0,7);c.fill();c.restore()}else{c.fillStyle='#e6eef9';for(let i=0;i<4;i++){c.beginPath();c.moveTo(x+i*h.w/4,y+h.h);c.lineTo(x+(i+.5)*h.w/4,y);c.lineTo(x+(i+1)*h.w/4,y+h.h);c.fill()}}}
      for(const coin of this.data.coins){if(coin.got)continue;const x=coin.x-cam,y=this.sy(coin.y);if(x<-60||x>W+60)continue;c.save();c.shadowColor='#ffd64d';c.shadowBlur=18;c.fillStyle='#ffca34';c.beginPath();c.arc(x,y,18,0,7);c.fill();c.strokeStyle='#fff0a4';c.lineWidth=5;c.stroke();c.fillStyle='#f7a91b';c.fillRect(x-5,y-10,10,20);c.restore()}
      for(const cube of this.data.cubes){if(cube.got)continue;const x=cube.x-cam,y=this.sy(cube.y);c.save();c.translate(x,y);c.rotate(performance.now()/900);c.shadowColor=th.accent;c.shadowBlur=26;c.fillStyle=th.accent;c.fillRect(-20,-20,40,40);c.strokeStyle='#eaffff';c.lineWidth=4;c.strokeRect(-20,-20,40,40);c.restore()}
      for(const k of this.data.keys){if(k.got)continue;const kw=k.w||48,kh=k.h||48,x=k.x-cam,y=this.sy(k.y),cy=y+kh/2;c.save();c.strokeStyle='#ffd14d';c.shadowColor='#ffd14d';c.shadowBlur=18;c.lineWidth=8;c.lineCap='round';c.beginPath();c.arc(x+13,cy,11,0,7);c.moveTo(x+24,cy);c.lineTo(x+kw-4,cy);c.moveTo(x+kw-13,cy);c.lineTo(x+kw-13,cy+10);c.stroke();c.restore()}
      for(const d of this.data.doors){if(d.open)continue;const x=d.x-cam,y=this.sy(d.y);c.fillStyle='#26384d';c.fillRect(x,y,d.w,d.h);c.strokeStyle=th.accent;c.lineWidth=4;c.strokeRect(x+8,y+8,d.w-16,d.h-16)}
      for(const s of this.data.switches){const x=s.x-cam,y=this.sy(s.y);c.fillStyle=s.active?'#56ed8e':'#ffcd4d';c.fillRect(x,y,s.w,s.h)}
      for(const cp of this.data.checkpoints){const x=cp.x-cam,y=this.sy(cp.y);c.strokeStyle='#405268';c.lineWidth=7;c.beginPath();c.moveTo(x+24,y+100);c.lineTo(x+24,y);c.stroke();c.fillStyle=cp.active?'#72ffb0':th.accent;c.fillRect(x+24,y,45,28)}
      for(const t of this.data.timers||[]){const x=(t.x??120)-cam,y=this.sy((t.y??260)-45),on=this.switches.has(t.link||'A');c.save();c.fillStyle=on?'#72ffb0':'#7b8aa5';c.beginPath();c.roundRect(x,y,50,34,8);c.fill();c.fillStyle='#102039';c.font='bold 15px system-ui';c.textAlign='center';c.fillText('⏱',x+25,y+23);c.restore()}
      for(const g of this.data.logicGates||[]){const x=g.x-cam,y=this.sy(g.y),on=!!g.active;c.save();c.shadowColor=on?'#64ffb0':'transparent';c.shadowBlur=on?16:0;c.fillStyle=on?'#2d9568':'#263a55';c.beginPath();c.roundRect(x,y,g.w,g.h,10);c.fill();c.strokeStyle=on?'#7dffc0':'#68dff5';c.lineWidth=3;c.strokeRect(x+3,y+3,g.w-6,g.h-6);c.fillStyle='#fff';c.font='bold 15px system-ui';c.textAlign='center';c.fillText(String(g.type||'and').toUpperCase(),x+g.w/2,y+21);c.font='10px system-ui';c.fillText(`${g.inputs||g.text||'A'} → ${g.link||'C'}`,x+g.w/2,y+38);c.restore()}
      for(const l of this.data.signalLamps||[]){const x=l.x-cam,y=this.sy(l.y),on=this.switches.has(l.link||'A')||this.keysOwned.has(l.link||'A');c.save();c.strokeStyle='#31465f';c.lineWidth=6;c.beginPath();c.moveTo(x+l.w/2,y+l.h);c.lineTo(x+l.w/2,y+26);c.stroke();c.fillStyle=on?'#71ff9d':'#596778';c.shadowColor=on?'#71ff9d':'transparent';c.shadowBlur=on?24:0;c.beginPath();c.arc(x+l.w/2,y+18,15,0,7);c.fill();c.restore()}
      for(const ch of this.data.chests||[]){if(ch.opened)continue;const x=ch.x-cam,y=this.sy(ch.y);if(x<-80||x>W+80)continue;c.save();c.shadowColor=ch.secret?'#c75cff':'#ffd25d';c.shadowBlur=15;c.fillStyle=ch.secret?'#5a367d':'#a96b32';c.beginPath();c.roundRect(x,y,ch.w,ch.h,8);c.fill();c.fillStyle=ch.secret?'#e7b4ff':'#ffd569';c.fillRect(x+4,y+7,ch.w-8,10);c.fillStyle='#1b2941';c.fillRect(x+ch.w/2-5,y+19,10,12);c.restore()}
      for(const door of this.data.interiorDoors||[]){const x=door.x-cam,y=this.sy(door.y);if(x<-100||x>W+100)continue;c.save();c.fillStyle='#152946';c.beginPath();c.roundRect(x,y,door.w,door.h,10);c.fill();c.strokeStyle=th.accent;c.lineWidth=4;c.strokeRect(x+6,y+6,door.w-12,door.h-12);c.fillStyle='#e7fbff';c.font='bold 12px system-ui';c.textAlign='center';c.fillText(door.label||'ENTRAR',x+door.w/2,y-8);c.fillStyle='#ffd55e';c.beginPath();c.arc(x+door.w-13,y+door.h/2,4,0,7);c.fill();c.restore()}
      for(const d of this.data.decor){const x=d.x-cam,y=this.sy(d.y);if(x>-220&&x<W+220)this.drawDecor(c,d,x,y)}
      for(const n of this.data.npcs){const x=n.x-cam,y=this.sy(n.y);if(x<-100||x>W+100)continue;this.drawNPC(c,n,x,y)}
      for(const e of this.data.enemies){if(e.dead)continue;const x=e.x-cam,y=this.sy(e.y);if(x<-180||x>W+180)continue;this.drawEnemy(c,e,x,y)}
      const g=this.data.goal,x=g.x-cam,y=this.sy(g.y);if(x>-120&&x<W+120){c.save();c.translate(x+g.w/2,y+g.h/2);c.shadowColor=th.accent;c.shadowBlur=35;c.strokeStyle=this.objectiveDone()?th.accent:'#708098';c.lineWidth=14;c.beginPath();c.ellipse(0,0,35,72,0,0,7);c.stroke();c.strokeStyle='#dffcff';c.lineWidth=3;c.beginPath();c.ellipse(0,0,25,61,0,0,7);c.stroke();c.restore()}
    }
    drawBlockPlatform(c,q,x,y){
      const raw=(q.material||'')||((q.type||'').replace('block_','')||'brick'),mat=raw==='crystal'?'glass':raw==='metal'?'iron':raw;
      const pal={brick:['#b54f3a','#e27a55','#7c3027'],stone:['#667585','#93a2b0','#485462'],iron:['#59697b','#a9bdcd','#314052'],wood:['#8f5937','#c98b52','#5f3825'],glass:['rgba(91,218,244,.42)','rgba(204,251,255,.9)','#3bbbd6'],obsidian:['#241d36','#5a3e86','#130f22'],roof:['#a43d46','#df7379','#6c2831'],grass:['#5d8049','#83cb65','#3b5933']}[mat]||['#8b5d3d','#cf9559','#5b3828'];
      c.save();c.fillStyle=pal[0];c.beginPath();c.roundRect(x,y,q.w,q.h,Math.min(9,q.h*.2));c.fill();
      if(mat==='brick'){
        c.strokeStyle=pal[2];c.lineWidth=3;const bh=28,bw=58;for(let yy=y+3,row=0;yy<y+q.h;yy+=bh,row++){c.beginPath();c.moveTo(x,yy);c.lineTo(x+q.w,yy);c.stroke();for(let xx=x+(row%2?bw/2:0);xx<x+q.w;xx+=bw){c.beginPath();c.moveTo(xx,yy);c.lineTo(xx,Math.min(y+q.h,yy+bh));c.stroke()}}
        c.fillStyle=pal[1];c.globalAlpha=.28;c.fillRect(x+5,y+5,q.w-10,7);
      }else if(mat==='stone'){
        c.strokeStyle=pal[2];c.lineWidth=2;for(let xx=x+20;xx<x+q.w;xx+=55){c.beginPath();c.moveTo(xx,y+5);c.lineTo(xx-12,y+q.h*.55);c.lineTo(xx+16,y+q.h-6);c.stroke()}c.fillStyle=pal[1];c.globalAlpha=.18;for(let xx=x+18;xx<x+q.w;xx+=48){c.beginPath();c.arc(xx,y+18+(xx%31),6,0,7);c.fill()}
      }else if(mat==='iron'){
        c.fillStyle=pal[1];c.globalAlpha=.32;c.fillRect(x+5,y+5,q.w-10,8);c.globalAlpha=1;c.strokeStyle=pal[2];c.lineWidth=3;for(let xx=x+36;xx<x+q.w;xx+=72){c.beginPath();c.moveTo(xx,y);c.lineTo(xx,y+q.h);c.stroke()}for(const px of [x+12,x+q.w-12])for(const py of [y+12,y+q.h-12]){c.fillStyle='#d8e5ec';c.beginPath();c.arc(px,py,4,0,7);c.fill()}
      }else if(mat==='wood'){
        c.strokeStyle=pal[2];c.lineWidth=4;for(let yy=y+18;yy<y+q.h;yy+=28){c.beginPath();c.moveTo(x+4,yy);c.quadraticCurveTo(x+q.w*.5,yy-8,x+q.w-4,yy+2);c.stroke()}c.fillStyle=pal[1];c.globalAlpha=.24;c.fillRect(x+7,y+5,q.w-14,8);
      }else if(mat==='glass'){
        c.strokeStyle=pal[1];c.lineWidth=4;c.strokeRect(x+3,y+3,q.w-6,q.h-6);c.fillStyle='rgba(255,255,255,.22)';c.beginPath();c.moveTo(x+12,y+q.h-8);c.lineTo(x+q.w*.45,y+8);c.lineTo(x+q.w*.6,y+8);c.lineTo(x+q.w*.28,y+q.h-8);c.fill();
      }else if(mat==='obsidian'){
        c.strokeStyle=pal[1];c.lineWidth=3;c.strokeRect(x+3,y+3,q.w-6,q.h-6);c.fillStyle='#7c57bf';c.globalAlpha=.32;for(let xx=x+15;xx<x+q.w;xx+=34){c.beginPath();c.moveTo(xx,y+q.h);c.lineTo(xx+20,y);c.lineTo(xx+28,y);c.lineTo(xx+8,y+q.h);c.fill()}
      }else{c.fillStyle=pal[1];c.fillRect(x,y,q.w,Math.min(14,q.h));c.strokeStyle=pal[2];c.lineWidth=3;c.strokeRect(x+2,y+2,q.w-4,q.h-4)}
      if(q.indestructible){c.fillStyle='rgba(120,220,255,.72)';c.font='bold 13px sans-serif';c.textAlign='right';c.fillText('◆',x+q.w-8,y+17)}
      else if((q.hp??999)<999){const max={brick:3,stone:5,wood:2,glass:1}[mat]||3,ratio=Math.max(0,Math.min(1,(q.hp??max)/max));if(ratio<1){c.strokeStyle='rgba(50,25,20,.7)';c.lineWidth=3;c.beginPath();c.moveTo(x+q.w*.25,y+5);c.lineTo(x+q.w*.48,y+q.h*.55);c.lineTo(x+q.w*.38,y+q.h-5);if(ratio<.55){c.moveTo(x+q.w*.7,y+3);c.lineTo(x+q.w*.55,y+q.h*.45);c.lineTo(x+q.w*.78,y+q.h-3)}c.stroke()}}
      if(q.placedByPlayer){c.globalAlpha=1;c.setLineDash([8,6]);c.strokeStyle='#6ff4ff';c.lineWidth=3;c.strokeRect(x+2,y+2,q.w-4,q.h-4);c.setLineDash([]);c.fillStyle='#d8fbff';c.font='bold 11px system-ui';c.textAlign='left';c.fillText('CONSTRUIDO',x+7,y+15)}
      c.restore();
    }
    drawDecor(c,d,x,y){
      c.save();const t=d.type,ph=this.time;
      if(t==='decor_tree'){c.fillStyle='#754b2f';c.fillRect(x-12,y,24,86);c.fillStyle='#4fba62';for(const [ox,oy,r] of [[0,-35,48],[-34,-16,32],[34,-14,34]]){c.beginPath();c.arc(x+ox,y+oy,r,0,7);c.fill()}}
      else if(t==='decor_bush'){c.fillStyle='#3da95b';for(const [ox,r] of [[-20,24],[0,32],[24,22]]){c.beginPath();c.arc(x+ox,y,r,0,7);c.fill()}}
      else if(t==='decor_flower'){c.fillStyle='#70b84a';c.fillRect(x-2,y-24,4,28);c.fillStyle=d.color||'#ff70c7';for(let a=0;a<6;a++){c.beginPath();c.arc(x+Math.cos(a*Math.PI/3)*9,y-28+Math.sin(a*Math.PI/3)*9,6,0,7);c.fill()}c.fillStyle='#ffd35e';c.beginPath();c.arc(x,y-28,5,0,7);c.fill()}
      else if(t==='decor_rock'){c.fillStyle='#6d8092';c.beginPath();c.roundRect(x-34,y-24,68,48,18);c.fill();c.fillStyle='#92a9bc';c.beginPath();c.arc(x-10,y-9,8,0,7);c.fill()}
      else if(t==='decor_lamp'){c.strokeStyle='#263b55';c.lineWidth=8;c.beginPath();c.moveTo(x,y+40);c.lineTo(x,y-55);c.stroke();c.fillStyle='#ffd85f';c.shadowColor='#ffd85f';c.shadowBlur=22;c.beginPath();c.arc(x,y-64,15,0,7);c.fill()}
      else if(t==='decor_crystal'){c.fillStyle=d.color||'#70efff';c.shadowColor=c.fillStyle;c.shadowBlur=20;c.beginPath();c.moveTo(x,y-55);c.lineTo(x+27,y-10);c.lineTo(x+12,y+34);c.lineTo(x-20,y+26);c.lineTo(x-30,y-16);c.closePath();c.fill()}
      else if(t==='decor_banner'){c.strokeStyle='#503922';c.lineWidth=7;c.beginPath();c.moveTo(x,y+46);c.lineTo(x,y-50);c.stroke();c.fillStyle=d.color||'#7a5cff';c.beginPath();c.moveTo(x+4,y-46);c.lineTo(x+62,y-35);c.lineTo(x+48,y+6);c.lineTo(x+4,y-6);c.closePath();c.fill()}
      else if(t==='decor_column'){c.fillStyle='#9da9b7';c.fillRect(x-22,y-65,44,112);c.fillStyle='#cbd7e2';c.fillRect(x-32,y-70,64,15);c.fillRect(x-32,y+38,64,14)}
      else if(t==='decor_torch'){c.strokeStyle='#5a3b25';c.lineWidth=7;c.beginPath();c.moveTo(x,y+34);c.lineTo(x,y-12);c.stroke();c.fillStyle='#ffb130';c.shadowColor='#ff6b20';c.shadowBlur=18;c.beginPath();c.arc(x,y-23,13+Math.sin(ph*8)*2,0,7);c.fill()}
      else if(t==='decor_sign'){c.fillStyle='#8b613b';c.fillRect(x-75,y-30,150,60);c.fillStyle='#fff2c8';c.font='16px sans-serif';c.textAlign='center';c.fillText((d.text||'SEÑAL').slice(0,18),x,y+5)}
      else if(t==='decor_coral'){c.translate(x,y);c.strokeStyle=d.color||'#ff718d';c.lineWidth=11;c.lineCap='round';for(const a of [-30,-15,0,18,33]){c.beginPath();c.moveTo(0,20);c.quadraticCurveTo(a*.5,-15,a,-48-Math.abs(a)*.25);c.stroke();if(Math.abs(a)>12){c.beginPath();c.moveTo(a*.45,-18);c.lineTo(a*.95,-30);c.stroke()}}}
      else if(t==='decor_seaweed'){c.translate(x,y);c.strokeStyle=d.color||'#55d991';c.lineWidth=9;c.lineCap='round';for(const sx of [-24,0,24]){c.beginPath();c.moveTo(sx,24);for(let yy=12;yy>-70;yy-=14)c.quadraticCurveTo(sx+Math.sin(ph*2+yy*.08+sx)*9,yy+7,sx+Math.sin(ph*2+yy*.08+sx)*5,yy);c.stroke()}}
      else if(t==='decor_anemone'){c.translate(x,y);c.fillStyle='#7b4b98';c.beginPath();c.ellipse(0,15,32,18,0,0,7);c.fill();c.strokeStyle=d.color||'#d58cff';c.lineWidth=6;c.lineCap='round';for(let i=0;i<11;i++){const a=-Math.PI*.9+i*Math.PI*1.8/10;c.beginPath();c.moveTo(Math.cos(a)*12,6);c.quadraticCurveTo(Math.cos(a)*28,-18+Math.sin(ph*3+i)*6,Math.cos(a)*38,-38+Math.sin(ph*2+i)*7);c.stroke()}}
      else if(t==='decor_shell'){c.translate(x,y);c.fillStyle=d.color||'#ffd078';c.strokeStyle='#b86d71';c.lineWidth=3;c.beginPath();c.arc(0,0,30,Math.PI,0);c.lineTo(28,15);c.quadraticCurveTo(0,35,-28,15);c.closePath();c.fill();c.stroke();for(let i=-2;i<=2;i++){c.beginPath();c.moveTo(0,4);c.lineTo(i*10,-23);c.stroke()}}
      else if(t==='decor_bubbles'){c.strokeStyle='rgba(205,250,255,.85)';c.lineWidth=3;for(let i=0;i<6;i++){const bx=x+Math.sin(i*2.2)*24,by=y-((ph*35+i*31)%130);c.globalAlpha=.35+(i%3)*.2;c.beginPath();c.arc(bx,by,5+(i%3)*3,0,7);c.stroke()}}
      c.restore();
    }
    drawCreatureNPC(c,n,x,y){
      const ph=n.phase||0,bob=Math.sin(ph*2.2+(n.creatureVariant||0))*2.2,blink=(ph%5.1)>4.88,sp=n.species||'robot',near=n.near,dir=n.dir||1;
      c.save();c.translate(x+n.w/2,y+n.h+bob);c.scale(dir,1);c.lineCap='round';c.lineJoin='round';
      const eye=(ex,ey,r=5)=>{c.fillStyle='#fff';c.beginPath();c.arc(ex,ey,r,0,7);c.fill();c.fillStyle='#18233a';if(blink)c.fillRect(ex-r+1,ey-1,r*2-2,2);else{c.beginPath();c.arc(ex+1,ey,Math.max(2,r*.45),0,7);c.fill()}};
      const shadow=()=>{c.fillStyle='rgba(0,0,0,.25)';c.beginPath();c.ellipse(0,3,30,7,0,0,7);c.fill()};shadow();
      if(sp==='robot'||sp==='toybot'||sp==='clockwork'){
        const toy=sp==='toybot',clock=sp==='clockwork';c.fillStyle=toy?'#ff7fc7':clock?'#cf9c52':'#7fd7ea';c.strokeStyle='#203650';c.lineWidth=4;c.beginPath();c.roundRect(-25,-65,50,42,10);c.fill();c.stroke();c.fillStyle='#0d2340';c.beginPath();c.roundRect(-16,-55,32,20,7);c.fill();c.fillStyle='#68f1ff';c.beginPath();c.arc(-7,-45,3,0,7);c.arc(7,-45,3,0,7);c.fill();c.strokeStyle='#203650';c.lineWidth=7;c.beginPath();c.moveTo(-14,-20);c.lineTo(-20,-2);c.moveTo(14,-20);c.lineTo(20,-2);c.stroke();c.fillStyle=toy?'#ffd85f':clock?'#80572e':'#4b7590';c.beginPath();c.roundRect(-22,-24,44,28,8);c.fill();if(clock){c.strokeStyle='#ffe6a8';c.lineWidth=3;c.beginPath();c.arc(0,-10,9,0,7);c.stroke();c.beginPath();c.moveTo(0,-10);c.lineTo(5,-15);c.moveTo(0,-10);c.lineTo(-4,-6);c.stroke()}c.strokeStyle='#31465d';c.lineWidth=6;c.beginPath();c.moveTo(0,-66);c.lineTo(0,-78);c.stroke();c.fillStyle='#ffe36d';c.beginPath();c.arc(0,-81,5,0,7);c.fill();
      }else if(['fox','snowfox'].includes(sp)){
        const col=sp==='snowfox'?'#eef7ff':'#e98745';c.fillStyle=col;c.beginPath();c.arc(0,-42,24,0,7);c.fill();c.beginPath();c.moveTo(-18,-57);c.lineTo(-25,-78);c.lineTo(-5,-64);c.moveTo(18,-57);c.lineTo(25,-78);c.lineTo(5,-64);c.fill();eye(-8,-44,5);eye(8,-44,5);c.fillStyle='#2a2230';c.beginPath();c.arc(0,-34,4,0,7);c.fill();c.fillStyle=col;c.beginPath();c.ellipse(0,-10,25,27,0,0,7);c.fill();c.strokeStyle=col;c.lineWidth=13;c.beginPath();c.moveTo(20,-12);c.quadraticCurveTo(50,-28,45,-4);c.stroke();c.strokeStyle='#fff';c.lineWidth=7;c.beginPath();c.moveTo(41,-7);c.lineTo(48,-2);c.stroke();
      }else if(sp==='rabbit'){
        c.fillStyle='#d6c8f3';c.beginPath();c.ellipse(-10,-66,8,25,-.15,0,7);c.ellipse(10,-66,8,25,.15,0,7);c.fill();c.beginPath();c.arc(0,-38,23,0,7);c.fill();eye(-8,-40);eye(8,-40);c.fillStyle='#f09caf';c.beginPath();c.arc(0,-31,4,0,7);c.fill();c.fillStyle='#b4a2dd';c.beginPath();c.ellipse(0,-8,25,24,0,0,7);c.fill();
      }else if(sp==='mole'||sp==='otter'){
        const col=sp==='mole'?'#76513c':'#9a6b4a';c.fillStyle=col;c.beginPath();c.ellipse(0,-28,29,33,0,0,7);c.fill();eye(-9,-38,5);eye(9,-38,5);c.fillStyle=sp==='mole'?'#e9a68c':'#4d2d24';c.beginPath();c.ellipse(0,-27,12,8,0,0,7);c.fill();c.fillStyle='#2e2020';c.beginPath();c.arc(0,-27,3,0,7);c.fill();c.strokeStyle=col;c.lineWidth=10;c.beginPath();c.moveTo(-22,-12);c.lineTo(-39,-3);c.moveTo(22,-12);c.lineTo(39,-3);c.stroke();
      }else if(sp==='penguin'){
        c.fillStyle='#182a42';c.beginPath();c.ellipse(0,-30,28,36,0,0,7);c.fill();c.fillStyle='#f7fbff';c.beginPath();c.ellipse(0,-25,18,25,0,0,7);c.fill();eye(-8,-45,5);eye(8,-45,5);c.fillStyle='#ffb63f';c.beginPath();c.moveTo(0,-35);c.lineTo(10,-30);c.lineTo(0,-27);c.closePath();c.fill();c.strokeStyle='#182a42';c.lineWidth=9;c.beginPath();c.moveTo(-20,-24);c.lineTo(-34,-10);c.moveTo(20,-24);c.lineTo(34,-10);c.stroke();
      }else if(sp==='yeti'){
        c.fillStyle='#dff7ff';c.beginPath();c.ellipse(0,-25,34,40,0,0,7);c.fill();c.fillStyle='#8fd0dd';c.beginPath();c.arc(0,-47,23,0,7);c.fill();eye(-8,-48);eye(8,-48);c.strokeStyle='#dff7ff';c.lineWidth=13;c.beginPath();c.moveTo(-25,-20);c.lineTo(-43,-1);c.moveTo(25,-20);c.lineTo(43,-1);c.stroke();
      }else if(['goblin','imp','alien'].includes(sp)){
        const col=sp==='goblin'?'#79bd5d':sp==='imp'?'#d95b55':'#7e7be7';c.fillStyle=col;c.beginPath();c.arc(0,-42,24,0,7);c.fill();c.beginPath();c.moveTo(-20,-44);c.lineTo(-42,-54);c.lineTo(-23,-32);c.moveTo(20,-44);c.lineTo(42,-54);c.lineTo(23,-32);c.fill();eye(-8,-43);eye(8,-43);c.fillStyle=sp==='imp'?'#5b2230':'#39415b';c.beginPath();c.roundRect(-23,-22,46,27,10);c.fill();if(sp==='imp'){c.fillStyle='#f3cf5e';c.beginPath();c.moveTo(-13,-62);c.lineTo(-8,-79);c.lineTo(-2,-61);c.moveTo(13,-62);c.lineTo(8,-79);c.lineTo(2,-61);c.fill()}
      }else if(sp==='fairy'||sp==='wisp'){
        const col=sp==='fairy'?'#ff91da':'#9f8cff';c.fillStyle='rgba(190,245,255,.6)';c.beginPath();c.ellipse(-20,-31,18,30,-.5,0,7);c.ellipse(20,-31,18,30,.5,0,7);c.fill();c.fillStyle=col;c.shadowColor=col;c.shadowBlur=18;c.beginPath();c.arc(0,-34,17,0,7);c.fill();c.beginPath();c.ellipse(0,-12,15,22,0,0,7);c.fill();c.shadowBlur=0;if(sp==='fairy'){eye(-6,-36,4);eye(6,-36,4)}
      }else if(sp==='golem'||sp==='crystalfolk'){
        const crystal=sp==='crystalfolk';c.fillStyle=crystal?'#6de6ff':'#87939f';c.strokeStyle=crystal?'#d5fbff':'#5c6873';c.lineWidth=4;c.beginPath();c.roundRect(-25,-63,50,39,8);c.fill();c.stroke();c.beginPath();c.roundRect(-31,-25,62,30,8);c.fill();c.stroke();c.fillStyle=crystal?'#fff':'#d9f7ff';c.beginPath();c.arc(-9,-45,4,0,7);c.arc(9,-45,4,0,7);c.fill();if(crystal){c.beginPath();c.moveTo(0,-82);c.lineTo(10,-64);c.lineTo(0,-56);c.lineTo(-10,-64);c.closePath();c.fill()}
      }else if(sp==='owl'||sp==='armored_owl'||sp==='griffin'){
        const armored=sp==='armored_owl',griff=sp==='griffin';c.fillStyle=griff?'#c99b5b':'#a88362';c.beginPath();c.ellipse(0,-30,28,34,0,0,7);c.fill();c.fillStyle='#f3e1bd';c.beginPath();c.arc(0,-46,23,0,7);c.fill();eye(-8,-48,7);eye(8,-48,7);c.fillStyle='#e4a535';c.beginPath();c.moveTo(0,-40);c.lineTo(8,-34);c.lineTo(-8,-34);c.closePath();c.fill();c.strokeStyle=griff?'#c99b5b':'#8c6e53';c.lineWidth=11;c.beginPath();c.moveTo(-23,-25);c.lineTo(-41,-8);c.moveTo(23,-25);c.lineTo(41,-8);c.stroke();if(armored){c.fillStyle='#607b98';c.beginPath();c.roundRect(-25,-25,50,25,7);c.fill();c.strokeStyle='#d7f5ff';c.lineWidth=3;c.stroke()}
      }else if(sp==='turtle'){
        c.fillStyle='#65aa69';c.beginPath();c.arc(0,-42,20,0,7);c.fill();eye(-7,-44,4);eye(7,-44,4);c.fillStyle='#4b7d55';c.beginPath();c.ellipse(0,-10,31,27,0,0,7);c.fill();c.strokeStyle='#87d47b';c.lineWidth=4;c.beginPath();c.moveTo(-20,-25);c.lineTo(20,5);c.moveTo(20,-25);c.lineTo(-20,5);c.stroke();
      }else if(sp==='merfolk'){
        c.fillStyle='#5ac6c0';c.beginPath();c.arc(0,-46,22,0,7);c.fill();eye(-8,-47);eye(8,-47);c.fillStyle='#396aa0';c.beginPath();c.ellipse(0,-20,22,23,0,0,7);c.fill();c.fillStyle='#63dbd2';c.beginPath();c.moveTo(0,0);c.lineTo(-24,20);c.lineTo(-6,18);c.lineTo(0,32);c.lineTo(6,18);c.lineTo(24,20);c.closePath();c.fill();
      }else if(sp==='crabfolk'){
        c.fillStyle='#e86a56';c.beginPath();c.ellipse(0,-26,30,27,0,0,7);c.fill();eye(-9,-42,5);eye(9,-42,5);c.strokeStyle='#c14b3c';c.lineWidth=8;for(const side of [-1,1]){c.beginPath();c.moveTo(side*23,-26);c.lineTo(side*42,-10);c.stroke();c.beginPath();c.arc(side*46,-6,8,0,7);c.stroke()}
      }else if(sp==='slime'){
        c.fillStyle='#6ed97e';c.beginPath();c.roundRect(-28,-48,56,52,22);c.fill();eye(-9,-30);eye(9,-30);c.strokeStyle='#2f8748';c.lineWidth=3;c.beginPath();c.arc(0,-20,10,.2,2.9);c.stroke();
      }else if(sp==='teddy'){
        c.fillStyle='#b97b4c';c.beginPath();c.arc(-17,-57,10,0,7);c.arc(17,-57,10,0,7);c.fill();c.beginPath();c.arc(0,-39,25,0,7);c.ellipse(0,-10,27,28,0,0,7);c.fill();eye(-8,-41);eye(8,-41);c.fillStyle='#4e3026';c.beginPath();c.arc(0,-31,5,0,7);c.fill();
      }else if(sp==='salamander'){
        c.fillStyle='#ff7b4e';c.beginPath();c.ellipse(0,-24,30,23,0,0,7);c.fill();c.beginPath();c.arc(-12,-45,17,0,7);c.fill();eye(-17,-47,4);c.strokeStyle='#ff7b4e';c.lineWidth=10;c.beginPath();c.moveTo(23,-22);c.quadraticCurveTo(53,-15,42,7);c.stroke();c.fillStyle='#ffd45a';for(let i=0;i<4;i++){c.beginPath();c.moveTo(-6+i*12,-44);c.lineTo(0+i*12,-60);c.lineTo(5+i*12,-42);c.fill()}
      }else if(sp==='wizard'){
        c.fillStyle='#6946a8';c.beginPath();c.moveTo(-28,-7);c.lineTo(0,-65);c.lineTo(28,-7);c.closePath();c.fill();c.fillStyle='#f0b887';c.beginPath();c.arc(0,-55,20,0,7);c.fill();eye(-7,-57,4);eye(7,-57,4);c.fillStyle='#563580';c.beginPath();c.moveTo(-29,-68);c.lineTo(0,-105);c.lineTo(26,-68);c.closePath();c.fill();c.fillStyle='#ffe66b';for(const [sx,sy] of [[0,-91],[-10,-78],[12,-72]]){c.beginPath();c.arc(sx,sy,3,0,7);c.fill()}c.strokeStyle='#9d6b3a';c.lineWidth=6;c.beginPath();c.moveTo(30,-56);c.lineTo(39,-2);c.stroke();c.fillStyle='#75f5ff';c.shadowColor='#75f5ff';c.shadowBlur=12;c.beginPath();c.arc(30,-60,8,0,7);c.fill();c.shadowBlur=0;
      }else{
        c.fillStyle='#76c6d8';c.beginPath();c.roundRect(-25,-58,50,58,16);c.fill();eye(-8,-42);eye(8,-42);
      }
      c.restore();
      c.save();c.translate(x+n.w/2,y+n.h+bob);if(n.name){c.fillStyle='rgba(4,19,45,.86)';c.beginPath();c.roundRect(-52,-118,104,21,8);c.fill();c.fillStyle='#dffcff';c.font='bold 10px system-ui';c.textAlign='center';c.fillText(`${n.name} · ${n.personality||'amable'}`,0,-103)}if(n.questGiver&&this.activeQuest?.status==='inactive'){c.fillStyle='#ffd84d';c.font='bold 24px sans-serif';c.textAlign='center';c.fillText('!',0,-126)}if(near){c.fillStyle='rgba(4,19,45,.94)';c.strokeStyle=n.special==='wizardQuiz'?'#d9a8ff':'#6eeaff';c.lineWidth=2;c.beginPath();c.roundRect(-72,-92,144,34,12);c.fill();c.stroke();c.fillStyle='#eafcff';c.font='bold 12px sans-serif';c.textAlign='center';c.fillText(n.special==='wizardQuiz'?'E · DESAFÍO':'E · HABLAR',0,-70)}c.restore();
    }
    drawNPC(c,n,x,y){
      if(n.species&&n.species!=='human')return this.drawCreatureNPC(c,n,x,y);
      const ph=n.phase||0,bob=Math.sin(ph*2+(n.variant||0))*(n.personality==='serious'?1:2.5),blink=(ph%5.3)>5.05,near=n.near,kind=n.kind||'guide',variant=n.variant||0,personality=n.personality||'helpful';
      const styles={
        guide:{coat:'#279fe5',trim:'#ffd06c',hair:'#6b3825',skin:'#f0b97f',hat:'scarf'},mechanic:{coat:'#ec873c',trim:'#5df1ff',hair:'#29323c',skin:'#d89462',hat:'goggles'},merchant:{coat:'#7e59d9',trim:'#ffd65d',hair:'#4e2e29',skin:'#efb887',hat:'pouch'},scout:{coat:'#42b979',trim:'#65eaff',hair:'#a9662e',skin:'#efbd87',hat:'cap'},villager:{coat:'#d65f82',trim:'#ffe07b',hair:'#75462e',skin:'#efb47d',hat:'hair'},guard:{coat:'#607794',trim:'#72efff',hair:'#322b2b',skin:'#d79a6c',hat:'helmet'},inventor:{coat:'#b74fc6',trim:'#7cf8ff',hair:'#eee9db',skin:'#e2a77a',hat:'goggles'},sailor:{coat:'#2f7dc7',trim:'#f4f7ff',hair:'#5b382a',skin:'#e7aa75',hat:'sailor'}
      };const st={...(styles[kind]||styles.guide)},biome=n.biome||this.npcBiome(n);if(biome==='knight'){st.coat='#526b8f';st.trim='#d8f4ff';st.hat='helmet'}if(biome==='polar'){st.coat='#7bc9df';st.trim='#f5fbff';st.hair='#493b35';st.hat='fur'}if(biome==='volcanic'){st.coat='#9f3c35';st.trim='#ffb347';st.hat='heat'}if(biome==='coastal'){st.coat='#2589c7';st.trim='#f8da67';st.hat='sailor'}if(biome==='miner'){st.coat='#a86d38';st.trim='#ffd45f';st.hat='miner'}if(biome==='sky'){st.coat='#547de6';st.trim='#8ff5ff';st.hat='pilot'}if(biome==='toy'){st.coat='#d95aa7';st.trim='#ffe36c';st.hat='cap'}if(biome==='void'){st.coat='#623b93';st.trim='#c895ff';st.hat='visor'}
      c.save();c.translate(x+n.w/2,y+bob);c.scale(n.dir||1,1);const wave=(near||n.gesture==='wave')?Math.sin(ph*8)*.55:n.gesture==='tool'?Math.sin(ph*5)*.28:Math.sin(ph*1.7)*.1,bodyW=[54,62,50,58][variant%4],headR=[28,25,31,27][variant%4];
      // shadow
      c.fillStyle='rgba(0,0,0,.28)';c.beginPath();c.ellipse(0,82,35,9,0,0,7);c.fill();
      // legs + boots
      c.strokeStyle='#263652';c.lineWidth=10;c.lineCap='round';c.beginPath();c.moveTo(-13,47);c.lineTo(-17,72+Math.sin(ph*2)*2);c.moveTo(13,47);c.lineTo(17,72-Math.sin(ph*2)*2);c.stroke();c.fillStyle='#17253a';c.beginPath();c.roundRect(-30,68,24,13,6);c.roundRect(6,68,24,13,6);c.fill();
      // body / jacket
      c.fillStyle=st.coat;c.beginPath();c.roundRect(-bodyW/2,16,bodyW,50,variant%2?12:17);c.fill();c.fillStyle=st.trim;c.globalAlpha=.85;c.fillRect(-bodyW/2+5,25,bodyW-10,7);c.globalAlpha=1;c.fillStyle='#263652';c.beginPath();c.roundRect(-12,20,24,34,8);c.fill();
      // arms + hands
      c.strokeStyle=st.coat;c.lineWidth=11;c.beginPath();c.moveTo(-22,28);c.lineTo(-40,46+wave*24);c.moveTo(22,28);c.lineTo(40,46-wave*24);c.stroke();c.fillStyle=st.skin;for(const px of [-40,40]){c.beginPath();c.arc(px,46+(px<0?wave:-wave)*24,7,0,7);c.fill()}
      // head
      c.fillStyle=st.skin;c.beginPath();c.arc(0,-4,headR,0,7);c.fill();c.fillStyle=st.hair;c.beginPath();c.arc(0,-13,27,Math.PI,0);c.lineTo(24,-2);c.quadraticCurveTo(10,-22,-2,-15);c.quadraticCurveTo(-15,-27,-25,-4);c.closePath();c.fill();
      // eyes / brows / smile
      c.fillStyle='#2b1f1c';if(blink){c.fillRect(-14,-6,9,2);c.fillRect(5,-6,9,2)}else{c.fillStyle='#fff';c.beginPath();c.ellipse(-9,-6,6,7,0,0,7);c.ellipse(9,-6,6,7,0,0,7);c.fill();c.fillStyle='#34231d';c.beginPath();c.arc(-8,-5,3,0,7);c.arc(10,-5,3,0,7);c.fill()}c.strokeStyle='#8c4f3f';c.lineWidth=2;c.beginPath();c.arc(0,5,9,.2,2.9);c.stroke();
      // profession identity
      if(st.hat==='goggles'){c.strokeStyle='#13233b';c.lineWidth=5;c.beginPath();c.arc(-9,-11,9,0,7);c.arc(9,-11,9,0,7);c.stroke();c.strokeStyle=st.trim;c.lineWidth=3;c.beginPath();c.moveTo(-18,-11);c.lineTo(18,-11);c.stroke()}
      if(st.hat==='helmet'){c.fillStyle='#687f9c';c.beginPath();c.arc(0,-13,30,Math.PI,0);c.lineTo(28,-5);c.lineTo(-28,-5);c.closePath();c.fill();c.fillStyle=st.trim;c.fillRect(-25,-10,50,5)}
      if(st.hat==='cap'){c.fillStyle='#2b6b52';c.beginPath();c.arc(0,-17,27,Math.PI,0);c.fill();c.fillRect(-24,-18,52,7)}
      if(st.hat==='sailor'){c.fillStyle='#f4f7ff';c.beginPath();c.arc(0,-17,26,Math.PI,0);c.fill();c.fillStyle='#2368a7';c.fillRect(-25,-18,50,6);c.fillRect(14,-23,17,4)}
      if(st.hat==='fur'){c.fillStyle='#eff8ff';c.beginPath();c.arc(0,-11,31,Math.PI,0);c.lineTo(29,0);c.lineTo(-29,0);c.closePath();c.fill();c.strokeStyle='#c9eaf5';c.lineWidth=5;c.beginPath();c.arc(0,-4,30,Math.PI*.96,Math.PI*.04,true);c.stroke()}
      if(st.hat==='heat'){c.fillStyle='#443b46';c.beginPath();c.arc(0,-14,30,Math.PI,0);c.fill();c.strokeStyle='#ff9e38';c.lineWidth=5;c.beginPath();c.arc(0,-11,24,Math.PI,0);c.stroke()}
      if(st.hat==='miner'){c.fillStyle='#e2a43c';c.beginPath();c.arc(0,-14,29,Math.PI,0);c.lineTo(28,-5);c.lineTo(-28,-5);c.closePath();c.fill();c.fillStyle='#fff0a0';c.beginPath();c.arc(0,-24,6,0,7);c.fill()}
      if(st.hat==='pilot'){c.fillStyle='#384a72';c.beginPath();c.arc(0,-13,28,Math.PI,0);c.fill();c.strokeStyle='#79efff';c.lineWidth=4;c.beginPath();c.arc(-9,-12,9,0,7);c.arc(9,-12,9,0,7);c.stroke()}
      if(st.hat==='visor'){c.fillStyle='#271c3e';c.beginPath();c.arc(0,-14,29,Math.PI,0);c.fill();c.fillStyle='#b57cff';c.globalAlpha=.72;c.beginPath();c.roundRect(-20,-12,40,12,6);c.fill();c.globalAlpha=1}
      if(st.hat==='scarf'){c.fillStyle=st.trim;c.beginPath();c.moveTo(-17,18);c.lineTo(20,18);c.lineTo(11,34);c.lineTo(-12,31);c.closePath();c.fill()}
      if(st.hat==='pouch'){c.fillStyle='#8c5830';c.beginPath();c.roundRect(24,34,17,20,5);c.fill();c.strokeStyle='#d6a866';c.lineWidth=2;c.stroke()}
      if(kind==='inventor'){c.fillStyle=st.trim;c.beginPath();c.arc(0,38,7,0,7);c.fill();c.strokeStyle=st.trim;c.lineWidth=3;c.beginPath();c.moveTo(0,45);c.lineTo(0,58);c.stroke()}
      if(kind==='guard'){c.fillStyle='#536b82';c.beginPath();c.roundRect(-48,32,18,30,7);c.fill();c.strokeStyle=st.trim;c.lineWidth=3;c.stroke()}
      if(biome==='knight'){c.fillStyle='#9fb4c9';c.beginPath();c.roundRect(-24,17,48,28,9);c.fill();c.strokeStyle='#e5f6ff';c.lineWidth=3;c.stroke();c.fillStyle='#55718f';c.beginPath();c.moveTo(0,23);c.lineTo(9,34);c.lineTo(0,47);c.lineTo(-9,34);c.closePath();c.fill()}
      if(biome==='polar'){c.strokeStyle='#f7fbff';c.lineWidth=7;c.beginPath();c.arc(0,17,25,.1,3.04);c.stroke()}
      if(biome==='volcanic'){c.fillStyle='#ff9b35';c.beginPath();c.arc(0,39,6+Math.sin(ph*4)*2,0,7);c.fill();c.fillStyle='#4c3a35';c.beginPath();c.roundRect(-36,20,10,34,4);c.fill();c.strokeStyle='#ffb047';c.lineWidth=3;c.beginPath();c.moveTo(-31,20);c.lineTo(-31,5);c.stroke()}
      if(biome==='miner'){c.strokeStyle='#6b4529';c.lineWidth=4;c.beginPath();c.moveTo(31,25);c.lineTo(47,5);c.stroke();c.beginPath();c.arc(48,2,8,Math.PI*.9,Math.PI*1.8);c.stroke();c.fillStyle='#75502f';c.beginPath();c.roundRect(-39,24,11,28,4);c.fill()}
      if(biome==='knight'){c.strokeStyle='#d9ecff';c.lineWidth=4;c.beginPath();c.moveTo(34,22);c.lineTo(48,56);c.stroke();c.fillStyle='#6d84a1';c.beginPath();c.arc(-38,42,13,0,7);c.fill();c.strokeStyle='#d9ecff';c.stroke()}
      if(biome==='polar'){c.fillStyle='#eafaff';c.beginPath();c.arc(-40,47,9,0,7);c.arc(40,47,9,0,7);c.fill();c.fillStyle='#7ab7cb';c.beginPath();c.roundRect(-34,18,68,12,6);c.fill()}
      if(biome==='coastal'){c.strokeStyle='#f2e081';c.lineWidth=5;c.beginPath();c.arc(-37,42,12,0,7);c.stroke();c.fillStyle='#d8f8ff';c.beginPath();c.moveTo(36,18);c.lineTo(47,35);c.lineTo(34,49);c.closePath();c.fill()}
      if(biome==='sky'){c.fillStyle='#374c7e';c.beginPath();c.roundRect(-40,20,13,34,5);c.roundRect(27,20,13,34,5);c.fill();c.fillStyle='#76f2ff';c.beginPath();c.moveTo(-37,55);c.lineTo(-31,70);c.lineTo(-27,55);c.closePath();c.moveTo(37,55);c.lineTo(31,70);c.lineTo(27,55);c.closePath();c.fill()}
      if(biome==='toy'){c.fillStyle='#ffe36c';c.beginPath();c.arc(35,33,8+Math.sin(ph*4)*2,0,7);c.fill();c.strokeStyle='#fff1a2';c.lineWidth=3;c.beginPath();c.moveTo(35,24);c.lineTo(35,4);c.stroke()}
      if(biome==='void'){c.fillStyle='#c895ff';c.shadowColor='#c895ff';c.shadowBlur=12;c.beginPath();c.moveTo(35,18);c.lineTo(44,34);c.lineTo(35,49);c.lineTo(26,34);c.closePath();c.fill();c.shadowBlur=0}
      if(n.name){c.save();c.scale(n.dir||1,1);c.fillStyle='rgba(4,19,45,.82)';c.beginPath();c.roundRect(-42,-118,84,21,8);c.fill();c.fillStyle='#dffcff';c.font='bold 10px system-ui';c.textAlign='center';c.fillText(`${n.name} · ${personality}`,0,-103);c.restore()}
      if(n.questGiver&&this.activeQuest?.status==='inactive'){c.fillStyle='#ffd84d';c.font='bold 24px sans-serif';c.textAlign='center';c.fillText('!',0,-100)}else if(n.questGiver&&this.activeQuest?.status==='completed'){c.fillStyle='#65f29b';c.font='bold 22px sans-serif';c.textAlign='center';c.fillText('✓',0,-100)}
      if(near){c.scale(n.dir||1,1);c.fillStyle='rgba(4,19,45,.94)';c.strokeStyle='#6eeaff';c.lineWidth=2;c.beginPath();c.roundRect(-65,-84,130,34,12);c.fill();c.stroke();c.fillStyle='#eafcff';c.font='bold 12px sans-serif';c.textAlign='center';c.fillText('E · HABLAR',0,-62)}
      c.restore();
    }
    drawEnemy(c,e,x,y){const blink=(e.phase%4.7)>4.48,wob=Math.sin(e.phase*6),pulse=1+Math.sin(e.phase*4)*.04;if(e.type==='boss'){c.save();c.translate(x+e.w/2,y+e.h/2);c.scale(pulse,pulse);c.fillStyle=e.state==='phase2'?'#55264d':'#382a56';if(e.state==='phase2'){c.shadowColor='#ff5f9f';c.shadowBlur=32}c.beginPath();c.roundRect(-e.w/2,-e.h/2+10,e.w,e.h-10,42);c.fill();c.strokeStyle=e.state==='phase2'?'#ff6fae':this.theme.accent;c.lineWidth=7;c.stroke();c.fillStyle='#ff6f6f';for(const ex of [-28,28]){c.beginPath();c.arc(ex,-28,13,0,7);c.fill()}c.fillStyle='#fff';c.font='bold 18px sans-serif';c.textAlign='center';c.fillText('GUARDIÁN',0,-e.h/2);c.fillStyle='rgba(0,0,0,.5)';c.fillRect(-e.w/2+10,e.h/2+10,e.w-20,10);c.fillStyle='#ff5d72';c.fillRect(-e.w/2+10,e.h/2+10,(e.w-20)*(e.hp/e.maxHp),10);c.restore();return}
      if(e.type==='drone'||e.type==='bat'){c.save();c.translate(x+e.w/2,y+e.h/2);c.rotate(wob*.03);if(e.type==='bat'){c.fillStyle='#5a3a82';c.beginPath();c.moveTo(-10,0);c.quadraticCurveTo(-48,-35-wob*8,-34,13);c.lineTo(-8,12);c.moveTo(10,0);c.quadraticCurveTo(48,-35+wob*8,34,13);c.lineTo(8,12);c.fill();c.fillStyle='#8d65bb';c.beginPath();c.ellipse(0,0,22,18,0,0,7);c.fill()}else{c.fillStyle='#eff8ff';c.strokeStyle='#153d62';c.lineWidth=5;c.beginPath();c.roundRect(-30,-24,60,48,18);c.fill();c.stroke();c.fillStyle='#071a33';c.beginPath();c.roundRect(-20,-13,40,26,11);c.fill()}c.fillStyle='#62efff';if(blink)c.fillRect(-12,-1,24,3);else{c.beginPath();c.arc(-8,0,4,0,7);c.arc(8,0,4,0,7);c.fill()}c.restore();return}
      if(e.type==='guard'||e.type==='turret'){c.save();c.translate(x,y);c.fillStyle=e.type==='turret'?'#7d6a56':'#ff8e54';c.beginPath();c.roundRect(0,e.type==='turret'?12:0,e.w,e.h-(e.type==='turret'?12:0),15);c.fill();c.fillStyle='#192844';c.fillRect(10,12,e.w-20,26);c.fillStyle='#65eaff';if(blink)c.fillRect(18,24,e.w-36,3);else{c.fillRect(18,20,8,8);c.fillRect(34,20,8,8)}c.fillStyle='#415b76';c.save();c.translate(e.dir<0?-18:e.w-8,34);c.scale(e.dir,1);c.fillRect(0,0,30,12);c.restore();if(e.type==='guard'){c.strokeStyle='#2b3850';c.lineWidth=8;c.beginPath();c.moveTo(16,e.h-8);c.lineTo(12+wob*4,e.h+12);c.moveTo(e.w-16,e.h-8);c.lineTo(e.w-12-wob*4,e.h+12);c.stroke()}c.restore();return}
      if(['fish','shark','jellyfish','eel','seahorse','crab'].includes(e.type)){
        c.save();c.translate(x,y);c.scale(e.dir||1,1);
        if(e.type==='jellyfish'){c.fillStyle='#b980e8';c.globalAlpha=.9;c.beginPath();c.arc(e.w*.5,e.h*.38,e.w*.38,Math.PI,0);c.lineTo(e.w*.88,e.h*.42);c.quadraticCurveTo(e.w*.72,e.h*.55,e.w*.5,e.h*.48);c.quadraticCurveTo(e.w*.28,e.h*.55,e.w*.12,e.h*.42);c.closePath();c.fill();c.strokeStyle='#e5b8ff';c.lineWidth=4;for(let i=0;i<4;i++){const xx=e.w*(.28+i*.15);c.beginPath();c.moveTo(xx,e.h*.48);c.quadraticCurveTo(xx+Math.sin(this.time*4+i)*8,e.h*.72,xx-4,e.h);c.stroke()}}
        else if(e.type==='eel'){c.strokeStyle='#5dc68b';c.lineWidth=22;c.lineCap='round';c.beginPath();for(let i=0;i<5;i++){const xx=10+i*e.w/4,yy=e.h*.5+Math.sin(e.phase*4+i)*9;if(i===0)c.moveTo(xx,yy);else c.lineTo(xx,yy)}c.stroke();c.fillStyle='#78e3ad';c.beginPath();c.ellipse(13,e.h*.5,18,14,0,0,7);c.fill();c.fillStyle='#fff';c.beginPath();c.arc(7,e.h*.44,4,0,7);c.fill();c.fillStyle='#16283b';c.beginPath();c.arc(7,e.h*.44,2,0,7);c.fill()}
        else if(e.type==='seahorse'){c.fillStyle='#ffc95d';c.strokeStyle='#c88029';c.lineWidth=3;c.beginPath();c.arc(e.w*.48,e.h*.3,15,0,7);c.fill();c.beginPath();c.moveTo(e.w*.42,e.h*.42);c.quadraticCurveTo(e.w*.65,e.h*.55,e.w*.45,e.h*.68);c.quadraticCurveTo(e.w*.25,e.h*.8,e.w*.54,e.h*.88);c.stroke();c.beginPath();c.moveTo(e.w*.58,e.h*.28);c.lineTo(e.w*.9,e.h*.35);c.lineTo(e.w*.58,e.h*.39);c.closePath();c.fill();c.fillStyle='#fff';c.beginPath();c.arc(e.w*.42,e.h*.25,4,0,7);c.fill()}
        else if(e.type==='crab'){c.fillStyle='#e8684e';c.beginPath();c.ellipse(e.w*.5,e.h*.55,e.w*.28,e.h*.28,0,0,7);c.fill();c.strokeStyle='#bf4636';c.lineWidth=6;for(const side of [-1,1]){for(let i=0;i<3;i++){c.beginPath();c.moveTo(e.w*.5+side*16,e.h*.6+i*2);c.lineTo(e.w*.5+side*(30+i*7),e.h*.78+i*4);c.stroke()}c.beginPath();c.moveTo(e.w*.5+side*20,e.h*.4);c.lineTo(e.w*.5+side*36,e.h*.18);c.stroke();c.beginPath();c.arc(e.w*.5+side*43,e.h*.13,8,0,7);c.stroke()}c.fillStyle='#fff';for(const ex of [e.w*.39,e.w*.61]){c.beginPath();c.arc(ex,e.h*.38,5,0,7);c.fill()}}
        else{c.fillStyle=e.type==='shark'?'#477c9e':'#57b8f0';c.beginPath();c.ellipse(e.w*.45,e.h*.5,e.w*.42,e.h*.46,0,0,7);c.fill();c.beginPath();c.moveTo(e.w*.78,e.h*.5);c.lineTo(e.w,e.h*.1+wob*2);c.lineTo(e.w,e.h*.9-wob*2);c.fill();if(e.type==='shark'){c.fillStyle='#31566f';c.beginPath();c.moveTo(e.w*.45,e.h*.08);c.lineTo(e.w*.62,-8);c.lineTo(e.w*.65,e.h*.22);c.closePath();c.fill();c.fillStyle='#fff';c.beginPath();c.moveTo(e.w*.16,e.h*.62);c.lineTo(e.w*.42,e.h*.64);c.lineTo(e.w*.28,e.h*.78);c.closePath();c.fill()}c.fillStyle='#fff';c.beginPath();c.arc(e.w*.25,e.h*.38,5,0,7);c.fill();c.fillStyle='#17283b';c.beginPath();c.arc(e.w*.25,e.h*.38,2,0,7);c.fill()}
        c.restore();return}

      c.save();c.translate(x+e.w/2,y+e.h/2);const isHop=e.type==='hopper',isCharge=e.type==='charger',chargeScale=isCharge?(e.state==='charge'?1.18:e.state==='windup'?.96:1.08):1;c.scale(chargeScale,isHop?1+wob*.04:1-wob*.025);c.fillStyle=isCharge?(e.state==='windup'?'#ffbd58':e.state==='recover'?'#b86f58':'#e4774b'):isHop?'#5ac9a1':this.world===7?'#9a62e6':'#79c95a';c.beginPath();c.roundRect(-e.w/2,-e.h/2+8,e.w,e.h-8,18);c.fill();c.fillStyle='#fff';if(blink){c.fillRect(-19,-5,11,3);c.fillRect(8,-5,11,3)}else{c.beginPath();c.arc(-13,-4,7,0,7);c.arc(13,-4,7,0,7);c.fill();c.fillStyle='#142033';c.beginPath();c.arc(-11+(e.dir||1)*2,-3,3,0,7);c.arc(15+(e.dir||1)*2,-3,3,0,7);c.fill()}c.strokeStyle='#35503a';c.lineWidth=7;c.beginPath();c.moveTo(-17,e.h/2-5);c.lineTo(-22+wob*5,e.h/2+12);c.moveTo(17,e.h/2-5);c.lineTo(22-wob*5,e.h/2+12);c.stroke();c.restore()}
    navigationTarget(){return this.objectiveDone()?(this.data.goal||null):(this.objectiveTarget()||this.data.goal||null)}
    drawObjectiveGuide(c){const t=this.navigationTarget();if(!t)return;const tx=(t.x+(t.w||0)/2)-this.camera,ty=(t.y+(t.h||0)/2)-this.cameraY,margin=86,icon=this.objectiveDone()?'◈':this.data.objective.type==='collect'?'◆':this.data.objective.type==='defeat'?'⚔':this.data.objective.type==='key'?'🔑':this.data.objective.type==='boss'?'♛':'◈';
      if(tx>margin&&tx<W-margin&&ty>120&&ty<H-margin){c.save();const bob=Math.sin(this.time*5)*6;c.translate(tx,Math.max(95,ty-76+bob));c.shadowColor=this.theme.accent;c.shadowBlur=16;c.fillStyle=this.theme.accent;c.beginPath();c.moveTo(0,20);c.lineTo(-16,-4);c.lineTo(16,-4);c.closePath();c.fill();c.fillStyle='#fff';c.font='bold 16px system-ui';c.textAlign='center';c.fillText(icon,0,-12);c.restore();return}
      const cx=W/2,cy=H/2,dx=tx-cx,dy=ty-cy,len=Math.hypot(dx,dy)||1,ux=dx/len,uy=dy/len,rx=Math.abs((W/2-margin)/(ux||.001)),ry=Math.abs((H/2-margin)/(uy||.001)),r=Math.min(rx,ry),x=cx+ux*r,y=cy+uy*r;c.save();c.translate(x,y);c.rotate(Math.atan2(uy,ux));c.shadowColor=this.theme.accent;c.shadowBlur=18;c.fillStyle='rgba(5,25,55,.9)';c.strokeStyle=this.theme.accent;c.lineWidth=4;c.beginPath();c.roundRect(-44,-25,88,50,18);c.fill();c.stroke();c.fillStyle=this.theme.accent;c.beginPath();c.moveTo(38,0);c.lineTo(20,-11);c.lineTo(20,11);c.closePath();c.fill();c.rotate(-Math.atan2(uy,ux));c.fillStyle='#fff';c.font='bold 18px system-ui';c.textAlign='center';c.fillText(icon,-7,7);c.restore()}
    drawMiniMap(c,expanded=false){
      const d=this.data;if(!d||!this.player)return;const x=expanded?180:W-360,y=expanded?95:145,w=expanded?1240:320,h=expanded?690:175,pad=expanded?34:16,minX=d.minX??0,maxX=Math.max(d.width||1,minX+1),minY=d.minY??-300,maxY=Math.max(d.maxY??GROUND+400,minY+1),sx=(w-pad*2)/(maxX-minX),sy=(h-pad*2)/(maxY-minY),mx=v=>x+pad+(v-minX)*sx,my=v=>y+pad+(v-minY)*sy;
      c.save();c.fillStyle=expanded?'rgba(3,12,31,.96)':'rgba(3,16,38,.82)';c.strokeStyle=this.theme.accent;c.lineWidth=expanded?4:2;c.beginPath();c.roundRect(x,y,w,h,expanded?26:18);c.fill();c.stroke();
      c.save();c.beginPath();c.rect(x+pad,y+pad,w-pad*2,h-pad*2);c.clip();
      for(const water of d.waters||[]){c.fillStyle='rgba(44,177,235,.34)';c.fillRect(mx(water.x),my(water.y),Math.max(1,water.w*sx),Math.max(2,water.h*sy))}
      for(const q of d.platforms||[]){if(q.hp===0)continue;const material=q.material||'grass',palette=this.materialPalette?this.materialPalette(material):['#587','#9cf','#345'];c.fillStyle=palette[1]||'#8bd';c.globalAlpha=.8;c.fillRect(mx(q.x),my(q.y),Math.max(2,q.w*sx),Math.max(expanded?3:2,q.h*sy));c.globalAlpha=1}
      for(const n of d.npcs||[]){c.fillStyle='#74f7d0';c.beginPath();c.arc(mx(n.x+n.w/2),my(n.y+n.h/2),expanded?5:3,0,7);c.fill()}
      for(const e of d.enemies||[]){if(e.dead)continue;c.fillStyle=e.type==='boss'?'#ff72bf':'#ff786c';c.beginPath();c.arc(mx(e.x+e.w/2),my(e.y+e.h/2),expanded?5:3,0,7);c.fill()}
      const target=this.navigationTarget();if(target){c.fillStyle='#ffd95b';c.beginPath();c.arc(mx(target.x+(target.w||0)/2),my(target.y+(target.h||0)/2),expanded?8:5,0,7);c.fill()}
      if(d.goal){c.strokeStyle='#6ef4ff';c.lineWidth=expanded?4:2;c.beginPath();c.arc(mx(d.goal.x+d.goal.w/2),my(d.goal.y+d.goal.h/2),expanded?10:6,0,7);c.stroke()}
      c.fillStyle='#fff';c.shadowColor='#6ef4ff';c.shadowBlur=10;c.beginPath();c.arc(mx(this.player.x+this.player.w/2),my(this.player.y+this.player.h/2),expanded?8:5,0,7);c.fill();c.shadowBlur=0;
      c.strokeStyle='rgba(255,255,255,.45)';c.lineWidth=1;c.strokeRect(mx(this.camera),my(this.cameraY),W*sx,H*sy);c.restore();
      c.fillStyle='#e9fbff';c.font=expanded?'bold 24px system-ui':'bold 13px system-ui';c.textAlign='left';c.fillText(expanded?'MAPA DEL NIVEL · rutas arriba y abajo':'MAPA · G',x+pad,y+(expanded?28:13));
      if(expanded){c.font='15px system-ui';c.fillStyle='#a9dbea';c.fillText('● jugador   ● objetivo   ○ portal   ● enemigos   ● NPC',x+pad,y+h-16);c.textAlign='right';c.fillText('G · cerrar mapa',x+w-pad,y+28)}
      c.restore();
    }
    drawShots(c,cam,cy){for(const s of this.shots){c.save();c.fillStyle=this.theme.accent;c.shadowColor=this.theme.accent;c.shadowBlur=18;c.beginPath();c.arc(s.x-cam,this.sy(s.y),s.r,0,7);c.fill();c.restore()}for(const s of this.enemyShots){c.fillStyle='#ff5f72';c.beginPath();c.arc(s.x-cam,this.sy(s.y),8,0,7);c.fill()}}
    drawPlayer(c,p,cam,cy){const idlePhase=this.time%5.4,action=p.groundPound?'pound':p.crouching?'crouch':!p.onGround?(p.vy<0?'jump':'fall'):Math.abs(p.vx)>70?(Math.floor(this.time*8)%2?'runA':'runB'):(idlePhase>5.12?'blink':idlePhase>4.15?'idle2':'idle'),img=this.avatarImage(action),x=p.x-cam,y=this.sy(p.y);c.save();if(p.inv>0&&Math.floor(p.inv*10)%2===0)c.globalAlpha=.35;if(p.shield>0){c.strokeStyle='#67f0ff';c.shadowColor='#67f0ff';c.shadowBlur=24;c.lineWidth=7;c.beginPath();c.ellipse(x+p.w/2,y+p.h/2,62,78,0,0,7);c.stroke()}c.translate(x+p.w/2,y+p.h);c.scale(p.dir,1);const h=166,w=120;if(img.complete&&img.naturalWidth)c.drawImage(img,-w/2,-h+20,w,h);else{c.fillStyle=this.theme.accent;c.fillRect(-26,-90,52,90)}c.restore()}
    drawPet(c,p,cam,cy){const pet=MC.state.data.avatar.pet||'drone';if(pet==='none')return;const x=p.x-cam-p.dir*66,y=this.sy(p.y)+18+Math.sin(this.time*3)*9;c.save();c.translate(x,y);if(pet==='bee'){c.fillStyle='#ffc83d';c.beginPath();c.ellipse(0,0,22,16,0,0,7);c.fill();c.strokeStyle='#362716';c.lineWidth=5;c.beginPath();c.moveTo(-8,-14);c.lineTo(-8,14);c.moveTo(8,-14);c.lineTo(8,14);c.stroke();c.fillStyle='rgba(220,250,255,.8)';c.beginPath();c.ellipse(-18,-10,12,8,-.6,0,7);c.ellipse(18,-10,12,8,.6,0,7);c.fill()}else if(pet==='slime'){c.fillStyle='#67db7d';c.beginPath();c.roundRect(-22,-14,44,32,14);c.fill();c.fillStyle='#10243a';c.beginPath();c.arc(-7,-2,3,0,7);c.arc(7,-2,3,0,7);c.fill()}else if(pet==='fish'){c.fillStyle='#5abcf2';c.beginPath();c.ellipse(0,0,25,14,0,0,7);c.fill();c.beginPath();c.moveTo(20,0);c.lineTo(38,-16);c.lineTo(38,16);c.fill();c.fillStyle='white';c.beginPath();c.arc(-8,-4,4,0,7);c.fill()}else{c.fillStyle='#eef8ff';c.strokeStyle='#173e62';c.lineWidth=4;c.beginPath();c.roundRect(-28,-21,56,42,15);c.fill();c.stroke();c.fillStyle='#071a33';c.beginPath();c.roundRect(-18,-11,36,22,9);c.fill();c.fillStyle='#59efff';c.beginPath();c.arc(-7,0,3,0,7);c.arc(7,0,3,0,7);c.fill()}c.restore()}

    drawSummonedCompanion(c,p,cam,cy){if(!this.summonType)return;const x=p.x-cam+p.dir*92,y=this.sy(p.y+p.h)-8+Math.sin(this.time*3.4)*4;c.save();c.translate(x,y);c.scale(p.dir,1);if(this.summonType==='joshi'){c.fillStyle='#43c9a0';c.strokeStyle='#174d51';c.lineWidth=4;c.beginPath();c.ellipse(0,-22,34,24,0,0,7);c.fill();c.stroke();c.beginPath();c.arc(22,-44,19,0,7);c.fill();c.stroke();c.fillStyle='#fff';c.beginPath();c.arc(27,-49,6,0,7);c.fill();c.fillStyle='#183047';c.beginPath();c.arc(29,-49,3,0,7);c.fill();c.fillStyle='#ff9e3c';for(let i=0;i<4;i++){c.beginPath();c.moveTo(-10+i*11,-44);c.lineTo(-5+i*11,-60);c.lineTo(2+i*11,-43);c.fill()}c.strokeStyle='#174d51';c.lineWidth=9;c.beginPath();c.moveTo(-24,-9);c.lineTo(-34,5);c.moveTo(12,-6);c.lineTo(19,6);c.stroke();c.strokeStyle='#43c9a0';c.lineWidth=10;c.beginPath();c.moveTo(-30,-24);c.quadraticCurveTo(-52,-34,-48,-12);c.stroke();c.fillStyle='#e8f2ff';c.beginPath();c.roundRect(-10,-31,23,16,6);c.fill();c.fillStyle='#6d4ad0';c.fillRect(-7,-28,17,9)}else{const wing=Math.sin(this.time*7)*.25;c.fillStyle='#fff7ff';c.strokeStyle='#835cc1';c.lineWidth=4;c.save();c.rotate(-wing);c.beginPath();c.ellipse(-31,-35,28,13,-.5,0,7);c.fill();c.stroke();c.restore();c.save();c.rotate(wing);c.beginPath();c.ellipse(24,-35,28,13,.5,0,7);c.fill();c.stroke();c.restore();c.beginPath();c.ellipse(0,-24,34,25,0,0,7);c.fill();c.stroke();c.beginPath();c.arc(26,-49,18,0,7);c.fill();c.stroke();c.fillStyle='#fff';c.beginPath();c.arc(31,-52,5,0,7);c.fill();c.fillStyle='#2d2344';c.beginPath();c.arc(32,-52,2.5,0,7);c.fill();c.fillStyle='#ffd85e';c.beginPath();c.moveTo(28,-67);c.lineTo(35,-92);c.lineTo(41,-66);c.closePath();c.fill();c.fillStyle='#b779ff';c.strokeStyle='#b779ff';c.lineWidth=7;c.beginPath();c.moveTo(8,-47);c.quadraticCurveTo(-2,-65,-15,-50);c.stroke();c.beginPath();c.moveTo(-26,-25);c.quadraticCurveTo(-52,-35,-50,-10);c.stroke();c.strokeStyle='#835cc1';c.lineWidth=8;c.beginPath();c.moveTo(-14,-4);c.lineTo(-18,9);c.moveTo(13,-3);c.lineTo(18,9);c.stroke()}c.restore()}
    drawCompanionSpeech(c,p,cam,cy){if(!this.companionSpeech||this.time>this.companionSpeech.until)return;const pet=MC.state.data.avatar.pet||'drone';if(pet==='none')return;const anchorX=clamp(p.x-cam-p.dir*70,180,W-180),anchorY=clamp(this.sy(p.y)-20,120,H-170),text=this.companionSpeech.text||'',max=250;const words=text.split(/\s+/),lines=[];let line='';c.save();c.font='bold 14px system-ui';for(const w of words){const test=(line?line+' ':'')+w;if(c.measureText(test).width>max&&line){lines.push(line);line=w}else line=test}if(line)lines.push(line);const bw=Math.min(max+30,Math.max(150,...lines.map(l=>c.measureText(l).width+30))),bh=24+lines.length*19;c.fillStyle='rgba(5,23,49,.94)';c.strokeStyle='#6feeff';c.lineWidth=2;c.beginPath();c.roundRect(anchorX-bw/2,anchorY-bh,bw,bh,15);c.fill();c.stroke();c.beginPath();c.moveTo(anchorX-8,anchorY);c.lineTo(anchorX+8,anchorY);c.lineTo(anchorX,anchorY+10);c.closePath();c.fill();c.fillStyle='#eaffff';c.textAlign='center';c.textBaseline='middle';lines.forEach((l,i)=>c.fillText(l,anchorX,anchorY-bh+17+i*19));c.restore()}
  }
  window.MC.Game=Game;
})();
